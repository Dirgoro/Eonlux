#!/bin/sh
set -eu

# 1. Normaliza quebras de linha (CRLF -> LF) em todos os arquivos customizados
find /etc/skel /etc/xdg /etc/plymouth /usr/share/plymouth /usr/local/bin -type f 2>/dev/null | while IFS= read -r file; do
    sed -i 's/\r$//' "$file" 2>/dev/null || true
done

# 2. Garante permissao de execucao nos scripts e sessao X11
chmod +x /usr/local/bin/eonluxos-* 2>/dev/null || true
chmod +x /etc/skel/.xinitrc 2>/dev/null || true

# 3. Gera os ativos PNG (bootloader e Plymouth) usando Python3 + PIL no chroot
python3 - <<'PY'
import os
from PIL import Image, ImageDraw, ImageFont

BG = (6, 12, 28)       # #060C1C
ACCENT = (19, 127, 236) # #137FEC
GLOW = (56, 189, 248)   # #38BDF8
WHITE = (255, 255, 255)

def load_font(size):
    for path in (
        "/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    ):
        if os.path.exists(path):
            return ImageFont.truetype(path, size)
    return ImageFont.load_default()

def draw_emblem(draw, cx, cy, r):
    draw.ellipse((cx - r - 10, cy - r - 10, cx + r + 10, cy + r + 10), outline=(19, 127, 236, 90), width=3)
    draw.ellipse((cx - r, cy - r, cx + r, cy + r), outline=ACCENT, width=5)
    inner = int(r * 0.58)
    draw.ellipse((cx - inner, cy - inner, cx + inner, cy + inner), outline=GLOW, width=3)
    core = int(r * 0.22)
    draw.ellipse((cx - core, cy - core, cx + core, cy + core), fill=GLOW)

# Splash ISOLINUX (640x480)
os.makedirs("/usr/share/eonluxos", exist_ok=True)
splash = Image.new("RGB", (640, 480), BG)
d = ImageDraw.Draw(splash)
d.rectangle((16, 16, 623, 463), outline=ACCENT, width=2)
draw_emblem(d, 320, 115, 42)
font_title = load_font(22)
title = "EonluxOS 1.0 Core"
bbox = d.textbbox((0, 0), title, font=font_title)
d.text(((640 - (bbox[2] - bbox[0])) // 2, 175), title, fill=WHITE, font=font_title)
splash.save("/usr/share/eonluxos/eonlux-splash.png", "PNG")

# Ativos Plymouth
ply_dir = "/usr/share/plymouth/themes/eonluxos"
if os.path.isdir(ply_dir):
    logo = Image.new("RGBA", (160, 160), (0, 0, 0, 0))
    dl = ImageDraw.Draw(logo)
    draw_emblem(dl, 80, 80, 62)
    logo.save(os.path.join(ply_dir, "logo.png"), "PNG")

    bar_bg = Image.new("RGBA", (360, 8), (15, 23, 42, 220))
    bar_bg.save(os.path.join(ply_dir, "progress_box.png"), "PNG")

    bar_fg = Image.new("RGBA", (360, 8), (19, 127, 236, 255))
    bar_fg.save(os.path.join(ply_dir, "progress_bar.png"), "PNG")
PY

# 4. Configura Plymouth como tema padrao e inclui framebuffer no initramfs
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme eonluxos || true
fi

mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/splash

# 5. Evita apenas o getty@tty1 para nao sujar o Plymouth durante o boot
systemctl mask getty@tty1.service 2>/dev/null || true
rm -f /etc/systemd/system/plymouth-quit.service /etc/systemd/system/plymouth-quit-wait.service

# 6. Permite que o usuario live inicie o Xorg diretamente no tty2
mkdir -p /etc/X11
cat <<'EOF' > /etc/X11/Xwrapper.config
allowed_users=anybody
needs_root_rights=yes
EOF

# 7. Atualiza cache de icones GTK e reconstroi o initramfs
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

update-initramfs -u -k all 2>/dev/null || true
