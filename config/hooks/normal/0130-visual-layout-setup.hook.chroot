#!/bin/sh
set -eu

# 1. Normalizar quebras de linha CRLF -> LF e permissoes nos scripts EonluxOS
for script in \
    /usr/local/bin/eonluxos-apply-defaults.sh \
    /usr/local/bin/eonluxos-window-fit.sh
do
    if [ -f "$script" ]; then
        sed -i 's/\r$//' "$script"
        chmod 0755 "$script"
    fi
done

if [ -f /usr/share/plymouth/themes/eonluxos/eonluxos.script ]; then
    sed -i 's/\r$//' /usr/share/plymouth/themes/eonluxos/eonluxos.script
fi

# 2. Gerar ativos PNG do Plymouth e splash ISOLINUX (#060C1C / #137FEC) sem depender de PIL
python3 - <<'PY'
import math, os, struct, zlib

def write_png(path, w, h, pixels):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        row_start = y * w * 4
        raw.extend(pixels[row_start:row_start + w * 4])
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def solid_png(path, w, h, rgba):
    write_png(path, w, h, bytes(rgba) * (w * h))

theme_dir = "/usr/share/plymouth/themes/eonluxos"
solid_png(os.path.join(theme_dir, "progress-track.png"), 16, 6, (22, 34, 59, 255))
solid_png(os.path.join(theme_dir, "progress-fill.png"), 16, 6, (19, 127, 236, 255))
solid_png(os.path.join(theme_dir, "eonlux-splash.png"), 640, 480, (6, 12, 28, 255))

# Emblema orbital 96x96 para Plymouth
w, h = 96, 96
cx, cy = (w - 1) / 2.0, (h - 1) / 2.0
buf = bytearray(w * h * 4)
for y in range(h):
    for x in range(w):
        dx, dy = x - cx, y - cy
        dist = math.hypot(dx, dy)
        idx = (y * w + x) * 4
        if dist <= 10.0:
            buf[idx:idx+4] = b"\x38\xbd\xf8\xff"
        elif 26.0 <= dist <= 29.5:
            buf[idx:idx+4] = b"\x13\x7f\xec\xff"
        elif 38.0 <= dist <= 40.5 and (dx + dy) > -18:
            buf[idx:idx+4] = b"\x38\xbd\xf8\xcc"
write_png(os.path.join(theme_dir, "emblem.png"), w, h, buf)
PY

# 3. Pre-popular lancadores da dock inferior (panel-2) em /etc/skel para exibir icones reais
SKEL_PANEL="/etc/skel/.config/xfce4/panel"
mkdir -p \
    "$SKEL_PANEL/launcher-10" \
    "$SKEL_PANEL/launcher-11" \
    "$SKEL_PANEL/launcher-12" \
    "$SKEL_PANEL/launcher-13" \
    "$SKEL_PANEL/launcher-14"

copy_launcher() {
    id="$1"
    desktop_name="$2"
    if [ -f "/usr/share/applications/${desktop_name}" ]; then
        cp -f "/usr/share/applications/${desktop_name}" "$SKEL_PANEL/launcher-${id}/${desktop_name}"
    fi
}

copy_launcher 10 "firefox-esr.desktop"
copy_launcher 11 "thunar.desktop"
copy_launcher 12 "xfce4-terminal.desktop"
copy_launcher 13 "galculator.desktop"
copy_launcher 14 "xfce-settings-manager.desktop"

# 4. Remover overrides antigos de unidades systemd que causavam deadlock no boot
rm -rf /etc/systemd/system/plymouth-quit.service.d
rm -rf /etc/systemd/system/plymouth-quit-wait.service.d
rm -rf /etc/systemd/system/lightdm.service.d
rm -f /etc/lightdm/lightdm.conf.d/50-eonluxos-plymouth.conf

# 5. Silenciar completamente mensagens de login no tty1 (--skip-login --noissue)
: > /etc/issue
: > /etc/issue.net
: > /etc/motd
touch /etc/skel/.hushlogin
chmod 0644 /etc/skel/.hushlogin

mkdir -p /etc/systemd/system/getty@tty1.service.d
cat <<'EOF' > /etc/systemd/system/getty@tty1.service.d/zz-eonluxos-silent.conf
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin user --skip-login --noissue --noclear %I $TERM
EOF
chmod 0644 /etc/systemd/system/getty@tty1.service.d/zz-eonluxos-silent.conf

# 6. Configurar permissoes do Xorg (Xwrapper), LightDM e evitar timeouts D-Bus/AT-SPI
mkdir -p /etc/X11 /etc/lightdm/lightdm.conf.d /etc/xdg/autostart
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager

cat <<'EOF' > /etc/X11/Xwrapper.config
allowed_users=anybody
needs_root_rights=yes
EOF
chmod 0644 /etc/X11/Xwrapper.config

cat <<'EOF' > /etc/lightdm/lightdm.conf.d/50-eonluxos-autologin.conf
[LightDM]
minimum-vt=7
logind-check-graphical=true

[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
autologin-user=user
autologin-user-timeout=0
EOF
chmod 0644 /etc/lightdm/lightdm.conf.d/50-eonluxos-autologin.conf

chmod 0755 /etc/skel/.xinitrc 2>/dev/null || true
chmod 0644 /etc/skel/.bash_profile 2>/dev/null || true

if [ -f /etc/xdg/autostart/at-spi-dbus-bus.desktop ]; then
    grep -qx "Hidden=true" /etc/xdg/autostart/at-spi-dbus-bus.desktop || echo "Hidden=true" >> /etc/xdg/autostart/at-spi-dbus-bus.desktop
fi

systemctl unmask getty@tty1.service || true
systemctl set-default graphical.target || true
systemctl enable lightdm.service || true

# 7. Configurar Plymouth no initramfs com FRAMEBUFFER=y e modulos KMS
mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/eonluxos-plymouth

for mod in i915 amdgpu radeon nouveau vmwgfx virtio_gpu bochs simpledrm; do
    grep -qx "$mod" /etc/initramfs-tools/modules 2>/dev/null || echo "$mod" >> /etc/initramfs-tools/modules
done

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R eonluxos || update-initramfs -u -k all
elif command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all
fi
