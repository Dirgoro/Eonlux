#!/bin/sh
set -eu

# 1. Normaliza quebras de linha (LF) e permissoes nos scripts EonluxOS
for script in \
    /usr/local/bin/eonluxos-apply-defaults.sh \
    /usr/local/bin/eonluxos-window-fit.sh
do
    if [ -f "$script" ]; then
        sed -i 's/\r$//' "$script"
        chmod 0755 "$script"
    fi
done

if [ -f /usr/share/plymouth/themes/eonluxos/eonluxos.script ]; then
    sed -i 's/\r$//' /usr/share/plymouth/themes/eonluxos/eonluxos.script
fi

# 2. Gera texturas da barra de progresso do Plymouth (#16223B / #137FEC)
python3 - <<'PY'
import os, struct, zlib

def write_png(path, w, h, rgba):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    raw = bytearray()
    row = bytes(rgba) * w
    for _ in range(h):
        raw.append(0)
        raw.extend(row)
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw))) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

theme_dir = "/usr/share/plymouth/themes/eonluxos"
write_png(os.path.join(theme_dir, "progress-track.png"), 16, 6, (22, 34, 59, 255))
write_png(os.path.join(theme_dir, "progress-fill.png"), 16, 6, (19, 127, 236, 255))
PY

# 3. Pre-popula os ficheiros .desktop reais dos lancadores da dock (panel-2) em /etc/skel
# Evita icones genericos verdes e elimina a necessidade de reiniciar o painel no login
SKEL_PANEL="/etc/skel/.config/xfce4/panel"
mkdir -p \
    "$SKEL_PANEL/launcher-10" \
    "$SKEL_PANEL/launcher-11" \
    "$SKEL_PANEL/launcher-12" \
    "$SKEL_PANEL/launcher-13" \
    "$SKEL_PANEL/launcher-14"

copy_launcher() {
    id="$1"
    desktop_name="$2"
    if [ -f "/usr/share/applications/${desktop_name}" ]; then
        cp -f "/usr/share/applications/${desktop_name}" "$SKEL_PANEL/launcher-${id}/${desktop_name}"
    fi
}

copy_launcher 10 "firefox-esr.desktop"
copy_launcher 11 "thunar.desktop"
copy_launcher 12 "xfce4-terminal.desktop"
copy_launcher 13 "galculator.desktop"
copy_launcher 14 "xfce-settings-manager.desktop"

# 4. Evita duplicacao do nm-applet (mantem apenas o autostart nativo do sistema)
if [ -f /etc/xdg/autostart/nm-applet.desktop ]; then
    chmod 0644 /etc/xdg/autostart/nm-applet.desktop
fi

# 5. Retem o Plymouth ativo ate o script de sessao XFCE dispensar o splash
mkdir -p /etc/systemd/system/plymouth-quit.service.d
cat <<'EOF' > /etc/systemd/system/plymouth-quit.service.d/override.conf
[Service]
ExecStart=
ExecStart=/bin/true
EOF

mkdir -p /etc/systemd/system/plymouth-quit-wait.service.d
cat <<'EOF' > /etc/systemd/system/plymouth-quit-wait.service.d/override.conf
[Service]
ExecStart=
ExecStart=/bin/true
EOF

# 6. Atualiza cache de icones Papirus-Dark e hicolor para evitar icones cinzentos no desktop
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme eonluxos || true
fi

if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all
fi
