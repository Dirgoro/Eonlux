#!/bin/sh
set -eu

# 1. Normaliza quebras de linha (CRLF -> LF) e permissoes nos scripts e temas
for script in \
    /usr/local/bin/eonluxos-apply-defaults.sh \
    /usr/local/bin/eonluxos-window-fit.sh
do
    if [ -f "$script" ]; then
        sed -i 's/\r$//' "$script"
        chmod 0755 "$script"
    fi
done

if [ -f /usr/share/plymouth/themes/eonluxos/eonluxos.script ]; then
    sed -i 's/\r$//' /usr/share/plymouth/themes/eonluxos/eonluxos.script
fi

# 2. Rasteriza o logotipo oficial eonluxos-logo.svg para icones, Plymouth e Bootloader
SVG_LOGO="/usr/share/icons/hicolor/scalable/apps/eonluxos-logo.svg"
THEME_DIR="/usr/share/plymouth/themes/eonluxos"

mkdir -p \
    /usr/share/icons/hicolor/24x24/apps \
    /usr/share/icons/hicolor/48x48/apps \
    /usr/share/pixmaps \
    "$THEME_DIR"

if [ -f "$SVG_LOGO" ]; then
    chmod 0644 "$SVG_LOGO"
    if command -v rsvg-convert >/dev/null 2>&1; then
        rsvg-convert -w 24 -h 24 "$SVG_LOGO" -o /usr/share/icons/hicolor/24x24/apps/eonluxos-logo.png
        rsvg-convert -w 48 -h 48 "$SVG_LOGO" -o /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png
        rsvg-convert -w 104 -h 104 "$SVG_LOGO" -o "${THEME_DIR}/emblem.png"
        rsvg-convert -w 112 -h 112 "$SVG_LOGO" -o /tmp/eonluxos-logo-112.png
    else
        python3 - <<'PYSVG' || true
import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf

svg = "/usr/share/icons/hicolor/scalable/apps/eonluxos-logo.svg"
targets = [
    (24, "/usr/share/icons/hicolor/24x24/apps/eonluxos-logo.png"),
    (48, "/usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png"),
    (104, "/usr/share/plymouth/themes/eonluxos/emblem.png"),
    (112, "/tmp/eonluxos-logo-112.png"),
]
for size, out in targets:
    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(svg, size, size, True)
    pb.savev(out, "png", [], [])
PYSVG
    fi
    if [ -f /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png ]; then
        cp -f /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png /usr/share/pixmaps/eonluxos-logo.png
    fi
fi

chmod 0644 /usr/share/icons/hicolor/24x24/apps/eonluxos-logo.png 2>/dev/null || true
chmod 0644 /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png 2>/dev/null || true
chmod 0644 /usr/share/pixmaps/eonluxos-logo.png 2>/dev/null || true
chmod 0644 "${THEME_DIR}/emblem.png" 2>/dev/null || true

# 3. Gera texturas tonais do Plymouth e compoe eonlux-splash.png (640x480 RGB 24-bit)
python3 - <<'PY'
import math, os, struct, zlib

def write_png_rgba(path, w, h, buf):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    raw = bytearray()
    stride = w * 4
    for y in range(h):
        raw.append(0)
        raw.extend(buf[y * stride : (y + 1) * stride])
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def write_png_rgb24(path, w, h, rgba_buf):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        row_off = y * w * 4
        for x in range(w):
            p = row_off + x * 4
            raw.extend(rgba_buf[p : p + 3])
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def read_png_rgba(path):
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    pos = 8
    w = h = bit_depth = color_type = 0
    idat = bytearray()
    while pos < len(data):
        length = struct.unpack(">I", data[pos:pos+4])[0]
        ctype = data[pos+4:pos+8]
        chunk_data = data[pos+8:pos+8+length]
        pos += 12 + length
        if ctype == b"IHDR":
            w, h, bit_depth, color_type, _, _, _ = struct.unpack(">IIBBBBB", chunk_data)
        elif ctype == b"IDAT":
            idat.extend(chunk_data)
        elif ctype == b"IEND":
            break
    if bit_depth != 8 or color_type not in (2, 6):
        return None
    bpp = 4 if color_type == 6 else 3
    raw = zlib.decompress(bytes(idat))
    stride = w * bpp
    recon = bytearray(h * stride)
    in_pos = 0
    for y in range(h):
        ftype = raw[in_pos]
        in_pos += 1
        row_start = y * stride
        for i in range(stride):
            x = raw[in_pos + i]
            a = recon[row_start + i - bpp] if i >= bpp else 0
            b = recon[row_start - stride + i] if y > 0 else 0
            c = recon[row_start - stride + i - bpp] if (y > 0 and i >= bpp) else 0
            if ftype == 0:
                val = x
            elif ftype == 1:
                val = (x + a) & 0xff
            elif ftype == 2:
                val = (x + b) & 0xff
            elif ftype == 3:
                val = (x + ((a + b) >> 1)) & 0xff
            elif ftype == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)
                val = (x + pr) & 0xff
            else:
                val = x
            recon[row_start + i] = val
        in_pos += stride
    out = bytearray(w * h * 4)
    if bpp == 4:
        out[:] = recon
    else:
        for i in range(w * h):
            out[i*4:i*4+3] = recon[i*3:i*3+3]
            out[i*4+3] = 255
    return w, h, out

def lerp(a, b, t):
    return int(a + (b - a) * t)

theme_dir = "/usr/share/plymouth/themes/eonluxos"

# 3a. Trilho da barra de progresso (#0F1D3A com borda #1B3566)
tw, th = 340, 8
track = bytearray(tw * th * 4)
for y in range(th):
    for x in range(tw):
        idx = (y * tw + x) * 4
        if y == 0 or y == th - 1 or x == 0 or x == tw - 1:
            track[idx:idx+4] = bytes((27, 53, 102, 255))
        else:
            track[idx:idx+4] = bytes((15, 29, 58, 255))
write_png_rgba(os.path.join(theme_dir, "progress-track.png"), tw, th, track)

# 3b. Preenchimento tonal da barra (#0E62C7 -> #137FEC -> #38BDF8)
fw, fh = 340, 8
fill = bytearray(fw * fh * 4)
for y in range(fh):
    v_boost = 12 if y in (1, 2) else 0
    for x in range(fw):
        t = x / max(1, fw - 1)
        r = min(255, lerp(14, 56, t) + v_boost)
        g = min(255, lerp(98, 189, t) + v_boost)
        b = min(255, lerp(199, 248, t) + v_boost)
        idx = (y * fw + x) * 4
        fill[idx:idx+4] = bytes((r, g, b, 255))
write_png_rgba(os.path.join(theme_dir, "progress-fill.png"), fw, fh, fill)

# 3c. Halo radial suave para envolver o emblema no Plymouth (220x220)
aw, ah = 220, 220
aura = bytearray(aw * ah * 4)
cx_a, cy_a = aw / 2.0, ah / 2.0
max_r = aw / 2.0
for y in range(ah):
    for x in range(aw):
        d = math.hypot(x - cx_a, y - cy_a) / max_r
        if d < 1.0:
            falloff = (1.0 - d) ** 2.6
            alpha = int(58 * falloff)
            idx = (y * aw + x) * 4
            aura[idx:idx+4] = bytes((28, 145, 242, alpha))
write_png_rgba(os.path.join(theme_dir, "glow-aura.png"), aw, ah, aura)

# 3d. Arte eonlux-splash.png (640x480 RGB 24-bit sem alfa para Syslinux/GRUB)
W, H = 640, 480
canvas = bytearray(W * H * 4)

logo_cx, logo_cy = W / 2.0, 82.0
for y in range(H):
    ty = y / (H - 1)
    if ty < 0.5:
        u = ty * 2.0
        br, bg, bb = lerp(4, 6, u), lerp(8, 12, u), lerp(20, 28, u)
    else:
        u = (ty - 0.5) * 2.0
        br, bg, bb = lerp(6, 10, u), lerp(12, 20, u), lerp(28, 43, u)
    row = y * W * 4
    for x in range(W):
        dist = math.hypot((x - logo_cx) * 0.85, y - logo_cy)
        glow = max(0.0, 1.0 - dist / 185.0) ** 2.4
        r = min(255, int(br + 18 * glow))
        g = min(255, int(bg + 62 * glow))
        b = min(255, int(bb + 115 * glow))
        idx = row + x * 4
        canvas[idx:idx+4] = bytes((r, g, b, 255))

def blend_rect(x0, y0, rw, rh, rgba):
    sr, sg, sb, sa = rgba
    inv = 255 - sa
    for y in range(max(0, y0), min(H, y0 + rh)):
        row = y * W * 4
        for x in range(max(0, x0), min(W, x0 + rw)):
            idx = row + x * 4
            canvas[idx]     = (sr * sa + canvas[idx]     * inv) // 255
            canvas[idx + 1] = (sg * sa + canvas[idx + 1] * inv) // 255
            canvas[idx + 2] = (sb * sa + canvas[idx + 2] * inv) // 255
            canvas[idx + 3] = 255

for x in range(W):
    t = 1.0 - abs((x / (W - 1)) * 2.0 - 1.0)
    r = lerp(19, 56, t)
    g = lerp(127, 189, t)
    b = lerp(236, 248, t)
    blend_rect(x, 0, 1, 3, (r, g, b, 255))

cx0, cy0, cw, ch = 56, 154, W - 112, 246
blend_rect(cx0 + 2, cy0 + 2, cw - 4, ch - 4, (13, 26, 54, 215))

blend_rect(cx0 + 4, cy0, cw - 8, 1, (38, 92, 168, 255))
blend_rect(cx0 + 4, cy0 + ch - 1, cw - 8, 1, (27, 53, 102, 255))
blend_rect(cx0, cy0 + 4, 1, ch - 8, (27, 53, 102, 255))
blend_rect(cx0 + cw - 1, cy0 + 4, 1, ch - 8, (27, 53, 102, 255))

for dx, dy in [(1,1), (2,1), (1,2), (cw-2,1), (cw-3,1), (cw-2,2), (1,ch-2), (2,ch-2), (1,ch-3), (cw-2,ch-2), (cw-3,ch-2), (cw-2,ch-3)]:
    blend_rect(cx0 + dx, cy0 + dy, 1, 1, (30, 58, 110, 255))

logo_png = read_png_rgba("/tmp/eonluxos-logo-112.png")
if logo_png:
    lw, lh, lbuf = logo_png
    ox = (W - lw) // 2
    oy = 24
    for y in range(lh):
        dy = oy + y
        if dy < 0 or dy >= H:
            continue
        for x in range(lw):
            dx = ox + x
            if dx < 0 or dx >= W:
                continue
            sidx = (y * lw + x) * 4
            alpha = lbuf[sidx + 3]
            if alpha == 0:
                continue
            didx = (dy * W + dx) * 4
            inv = 255 - alpha
            canvas[didx]     = (lbuf[sidx]     * alpha + canvas[didx]     * inv) // 255
            canvas[didx + 1] = (lbuf[sidx + 1] * alpha + canvas[didx + 1] * inv) // 255
            canvas[didx + 2] = (lbuf[sidx + 2] * alpha + canvas[didx + 2] * inv) // 255
            canvas[didx + 3] = 255

write_png_rgb24(os.path.join(theme_dir, "eonlux-splash.png"), W, H, canvas)
PY

rm -f /tmp/eonluxos-logo-112.png

# 4. Garante o wallpaper oficial e sobrescreve os fallbacks azuis do Debian/XFCE
WALLPAPER_DIR="/usr/share/backgrounds/eonluxos"
WALLPAPER_FILE="${WALLPAPER_DIR}/eonlux-wallpaper.jpg"
mkdir -p "$WALLPAPER_DIR"

if [ ! -f "$WALLPAPER_FILE" ]; then
    FOUND_WP=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) | head -n 1)
    if [ -n "$FOUND_WP" ]; then
        cp -f "$FOUND_WP" "$WALLPAPER_FILE"
    fi
fi

if [ -f "$WALLPAPER_FILE" ]; then
    chmod 0644 "$WALLPAPER_FILE"
    mkdir -p /usr/share/backgrounds/xfce /usr/share/images/desktop-base
    ln -sf "$WALLPAPER_FILE" /usr/share/backgrounds/xfce/xfce-verticals.png
    ln -sf "$WALLPAPER_FILE" /usr/share/backgrounds/xfce/xfce-shapes.svg
    ln -sf "$WALLPAPER_FILE" /usr/share/backgrounds/xfce/xfce-blue.jpg
    ln -sf "$WALLPAPER_FILE" /usr/share/images/desktop-base/default
fi

# 5. Garante framebuffer imediato e modulos KMS/DRM no initramfs
mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/eonluxos-plymouth

for mod in i915 amdgpu radeon nouveau vmwgfx virtio_gpu bochs simpledrm; do
    grep -qx "$mod" /etc/initramfs-tools/modules 2>/dev/null || echo "$mod" >> /etc/initramfs-tools/modules
done

# 6. Retem o Plymouth ate o desktop XFCE estar desenhado
mkdir -p /etc/systemd/system/plymouth-quit.service.d /etc/systemd/system/plymouth-quit-wait.service.d
printf "[Service]\nExecStart=\nExecStart=/bin/true\n" > /etc/systemd/system/plymouth-quit.service.d/override.conf
printf "[Service]\nExecStart=\nExecStart=/bin/true\n" > /etc/systemd/system/plymouth-quit-wait.service.d/override.conf

systemctl mask getty@tty1.service 2>/dev/null || true

# 7. Atualiza cache de icones GTK e fixa o tema Plymouth no initramfs
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R eonluxos || update-initramfs -u -k all
elif command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all
fi
