#!/bin/sh
set -e

# 1. Normalizar quebras de linha (CRLF -> LF) e permissoes de execucao
for dir in /usr/local/bin /etc/xdg/xfce4 /etc/xdg/autostart /usr/share/plymouth/themes/eonluxos; do
    if [ -d "$dir" ]; then
        find "$dir" -type f \( -name "*.sh" -o -name "*.xml" -o -name "*.desktop" -o -name "*.script" -o -name "*.plymouth" -o -name "*.css" \) \
            -exec sed -i 's/\r$//' {} + 2>/dev/null || true
    fi
done

chmod +x /usr/local/bin/eonluxos-*.sh 2>/dev/null || true

# 2. Garantir estrutura de diretorios e links simbolicos de wallpaper
mkdir -p /usr/share/eonluxos \
         /usr/share/backgrounds/eonluxos \
         /usr/share/backgrounds/xfce \
         /usr/share/images/desktop-base \
         /usr/share/plymouth/themes/eonluxos

if [ -f /usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg ]; then
    ln -sf /usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg /usr/share/backgrounds/xfce/xfce-shapes.svg
    ln -sf /usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg /usr/share/backgrounds/xfce/xfce-verticals.png
    ln -sf /usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg /usr/share/images/desktop-base/default
fi

# 3. Gerar PNGs oficiais (Splash ISOLINUX 640x480 e emblemas Plymouth) dentro do chroot
if command -v python3 >/dev/null 2>&1; then
python3 - <<'PY' || true
import os

try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    raise SystemExit(0)

BG = (6, 12, 28, 255)        # #060C1C
ACCENT = (19, 127, 236, 255) # #137FEC
CYAN = (56, 189, 248, 255)   # #38BDF8
WHITE = (255, 255, 255, 255)
MUTED = (226, 232, 240, 255)

# Splash 640x480 para ISOLINUX / Plymouth
w, h = 640, 480
img = Image.new("RGBA", (w, h), BG)
draw = ImageDraw.Draw(img)

# Moldura sutil azul eletrico
draw.rectangle([16, 16, w - 17, h - 17], outline=ACCENT, width=2)

# Emblema orbital centralizado
cx, cy = w // 2, 175
draw.ellipse([cx - 46, cy - 46, cx + 46, cy + 46], outline=ACCENT, width=3)
draw.ellipse([cx - 32, cy - 32, cx + 32, cy + 32], outline=CYAN, width=2)
draw.ellipse([cx - 10, cy - 10, cx + 10, cy + 10], fill=ACCENT)

try:
    font_title = ImageFont.truetype("/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf", 28)
    font_sub = ImageFont.truetype("/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf", 14)
except Exception:
    font_title = ImageFont.load_default()
    font_sub = ImageFont.load_default()

title = "EonluxOS 1.0 Core"
subtitle = "Revigorando seu hardware com leveza e estabilidade"
tb = draw.textbbox((0, 0), title, font=font_title)
sb = draw.textbbox((0, 0), subtitle, font=font_sub)
draw.text(((w - (tb[2] - tb[0])) // 2, 248), title, fill=WHITE, font=font_title)
draw.text(((w - (sb[2] - sb[0])) // 2, 290), subtitle, fill=MUTED, font=font_sub)

for out in [
    "/usr/share/eonluxos/eonlux-splash.png",
    "/usr/share/plymouth/themes/eonluxos/eonlux-splash.png",
]:
    img.convert("RGB").save(out, "PNG")

# Logo pequeno (96x96) para o tema Plymouth
logo = Image.new("RGBA", (96, 96), (0, 0, 0, 0))
ld = ImageDraw.Draw(logo)
ld.ellipse([6, 6, 90, 90], outline=ACCENT, width=4)
ld.ellipse([20, 20, 76, 76], outline=CYAN, width=2)
ld.ellipse([38, 38, 58, 58], fill=ACCENT)
logo.save("/usr/share/plymouth/themes/eonluxos/logo.png", "PNG")
PY
fi

# 4. Configurar Plymouth com framebuffer antecipado no initramfs
mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/splash

if [ -f /usr/share/plymouth/themes/eonluxos/eonluxos.plymouth ]; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
        /usr/share/plymouth/themes/eonluxos/eonluxos.plymouth 200 || true
    update-alternatives --set default.plymouth \
        /usr/share/plymouth/themes/eonluxos/eonluxos.plymouth || true
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme eonluxos || true
    fi
fi

# 5. Configurar LightDM com autologin e transicao limpa sem conflito com getty@tty1
mkdir -p /etc/lightdm/lightdm.conf.d
cat <<'EOF' > /etc/lightdm/lightdm.conf.d/50-eonluxos-autologin.conf
[LightDM]
minimum-vt=7

[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
autologin-user=user
autologin-user-timeout=0
xserver-command=X -core -ardelay 250 -arinterval 30
EOF

# Impedir que getty@tty1 dispute o framebuffer com o Plymouth durante o boot,
# mantendo tty2..tty6 disponiveis para diagnostico e garantindo o alvo grafico.
systemctl mask getty@tty1.service || true
systemctl unmask lightdm.service || true
systemctl enable lightdm.service || true
systemctl set-default graphical.target || true

# Drop-in no LightDM para assegurar troca de VT e encerramento limpo do Plymouth
mkdir -p /etc/systemd/system/lightdm.service.d
cat <<'EOF' > /etc/systemd/system/lightdm.service.d/10-eonluxos-plymouth.conf
[Unit]
After=systemd-user-sessions.service getty@tty1.service plymouth-quit.service
Conflicts=getty@tty1.service
EOF

# 6. Configurar tema padrao do LightDM GTK Greeter (fallback visual)
if [ -d /etc/lightdm ]; then
cat <<'EOF' > /etc/lightdm/lightdm-gtk-greeter.conf
[greeter]
background=/usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg
theme-name=Adwaita-dark
icon-theme-name=Papirus-Dark
font-name=Noto Sans 10
indicators=~host;~spacer;~clock;~power
clock-format=%H:%M
EOF
fi

# 7. Atualizar caches de icones, aplicativos e reconstruir initramfs
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    for icondir in /usr/share/icons/hicolor /usr/share/icons/Papirus-Dark; do
        [ -d "$icondir" ] && gtk-update-icon-cache -f -t "$icondir" || true
    done
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
fi

if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all || true
fi
