#!/bin/sh
set -eu

# 1. Normalizar quebras de linha CRLF -> LF e permissoes nos scripts EonluxOS
for script in \
    /usr/local/bin/eonluxos-apply-defaults.sh \
    /usr/local/bin/eonluxos-window-fit.sh
do
    if [ -f "$script" ]; then
        sed -i 's/\r$//' "$script"
        chmod 0755 "$script"
    fi
done

if [ -f /usr/share/plymouth/themes/eonluxos/eonluxos.script ]; then
    sed -i 's/\r$//' /usr/share/plymouth/themes/eonluxos/eonluxos.script
fi

# 2. Gerar ativos PNG distintos:
#    - plymouth-bg.png (1024x600): fundo atmosferico rico (ondas + constelacao)
#    - eonlux-splash.png (640x480 RGB 24-bit): fundo minimalista limpo para Bootloader
python3 - <<'PY'
import math, os, struct, zlib

def write_png_rgba(path, w, h, pixels):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    raw = bytearray()
    stride = w * 4
    for y in range(h):
        raw.append(0)
        raw.extend(pixels[y * stride : (y + 1) * stride])
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def write_png_rgb24(path, w, h, rgba_buf):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        row_off = y * w * 4
        for x in range(w):
            p = row_off + x * 4
            raw.extend(rgba_buf[p : p + 3])
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def read_png_rgba(path):
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    pos = 8
    w = h = bit_depth = color_type = 0
    idat = bytearray()
    while pos < len(data):
        length = struct.unpack(">I", data[pos:pos+4])[0]
        ctype = data[pos+4:pos+8]
        chunk_data = data[pos+8:pos+8+length]
        pos += 12 + length
        if ctype == b"IHDR":
            w, h, bit_depth, color_type, _, _, _ = struct.unpack(">IIBBBBB", chunk_data)
        elif ctype == b"IDAT":
            idat.extend(chunk_data)
        elif ctype == b"IEND":
            break
    if bit_depth != 8 or color_type not in (2, 6):
        return None
    bpp = 4 if color_type == 6 else 3
    raw = zlib.decompress(bytes(idat))
    stride = w * bpp
    recon = bytearray(h * stride)
    in_pos = 0
    for y in range(h):
        ftype = raw[in_pos]
        in_pos += 1
        row_start = y * stride
        for i in range(stride):
            x = raw[in_pos + i]
            a = recon[row_start + i - bpp] if i >= bpp else 0
            b = recon[row_start - stride + i] if y > 0 else 0
            c = recon[row_start - stride + i - bpp] if (y > 0 and i >= bpp) else 0
            if ftype == 0:
                val = x
            elif ftype == 1:
                val = (x + a) & 0xff
            elif ftype == 2:
                val = (x + b) & 0xff
            elif ftype == 3:
                val = (x + ((a + b) >> 1)) & 0xff
            elif ftype == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)
                val = (x + pr) & 0xff
            else:
                val = x
            recon[row_start + i] = val
        in_pos += stride
    out = bytearray(w * h * 4)
    if bpp == 4:
        out[:] = recon
    else:
        for i in range(w * h):
            out[i*4:i*4+3] = recon[i*3:i*3+3]
            out[i*4+3] = 255
    return w, h, out

def resize_rgba(src_w, src_h, src_buf, dst_w, dst_h):
    dst = bytearray(dst_w * dst_h * 4)
    for y in range(dst_h):
        sy = min(src_h - 1, int((y + 0.5) * src_h / dst_h))
        for x in range(dst_w):
            sx = min(src_w - 1, int((x + 0.5) * src_w / dst_w))
            sidx = (sy * src_w + sx) * 4
            didx = (y * dst_w + x) * 4
            dst[didx:didx+4] = src_buf[sidx:sidx+4]
    return dst

def lerp(a, b, t):
    return int(a + (b - a) * t)

def render_plymouth_backdrop(w, h):
    buf = bytearray(w * h * 4)
    cx, cy = w * 0.50, h * 0.40
    lx, ly = w * 0.14, h * 0.22
    max_center = math.hypot(w * 0.52, h * 0.52)
    max_left = math.hypot(w * 0.24, h * 0.24)

    for y in range(h):
        row = y * w * 4
        dy_c = (y - cy) * 1.15
        dy_l = y - ly
        for x in range(w):
            dc = math.hypot(x - cx, dy_c) / max_center
            gc = max(0.0, 1.0 - dc) ** 2.1

            dl = math.hypot(x - lx, dy_l) / max_left
            gl = max(0.0, 1.0 - dl) ** 2.4

            r = min(255, int(4 + 12 * gc + 10 * gl))
            g = min(255, int(9 + 46 * gc + 44 * gl))
            b = min(255, int(24 + 98 * gc + 74 * gl))
            idx = row + x * 4
            buf[idx:idx+4] = bytes((r, g, b, 255))

    def add_px(px, py, sr, sg, sb, sa):
        ix, iy = int(px), int(py)
        if 0 <= ix < w and 0 <= iy < h and sa > 0:
            idx = (iy * w + ix) * 4
            buf[idx]     = min(255, buf[idx]     + (sr * sa) // 255)
            buf[idx + 1] = min(255, buf[idx + 1] + (sg * sa) // 255)
            buf[idx + 2] = min(255, buf[idx + 2] + (sb * sa) // 255)

    def draw_line(x0, y0, x1, y1, col, alpha):
        dx, dy = x1 - x0, y1 - y0
        steps = max(1, int(max(abs(dx), abs(dy))))
        for s in range(steps + 1):
            t = s / steps
            add_px(x0 + dx * t, y0 + dy * t, col[0], col[1], col[2], alpha)

    def draw_node(nx, ny, radius, col, alpha):
        r_int = int(radius) + 1
        for oy in range(-r_int, r_int + 1):
            for ox in range(-r_int, r_int + 1):
                d = math.hypot(ox, oy)
                if d <= radius:
                    fall = int(alpha * (1.0 - d / (radius + 0.5)))
                    add_px(nx + ox, ny + oy, col[0], col[1], col[2], fall)

    # 1. Onda superior direita (7 linhas convergentes pontilhadas)
    for k in range(7):
        frac = k / 6.0
        alpha_line = int(85 + 75 * (1.0 - frac))
        prev = None
        steps = 260
        for s in range(steps + 1):
            t = s / steps
            px = w * (0.48 + 0.54 * t)
            base_y = h * (0.38 - 0.34 * (t ** 1.15))
            spread = h * (0.11 * (1.0 - t * 0.72)) * (frac - 0.35)
            wave = math.sin(t * 4.4 + frac * 1.1) * (h * 0.022)
            py = base_y + spread + wave
            if prev is not None:
                draw_line(prev[0], prev[1], px, py, (42, 168, 248), alpha_line)
            if s % 16 == 0:
                draw_node(px, py, 1.8, (140, 225, 255), min(255, alpha_line + 85))
            prev = (px, py)

    # 2. Onda inferior esquerda (8 linhas paralelas pontilhadas)
    for k in range(8):
        frac = k / 7.0
        alpha_line = int(75 + 75 * (1.0 - frac))
        prev = None
        steps = 280
        for s in range(steps + 1):
            t = s / steps
            px = w * (-0.02 + 0.68 * t)
            base_y = h * (0.97 - 0.28 * (t ** 1.08))
            spread = h * (0.095 * (1.0 - t * 0.45)) * (frac - 0.45)
            wave = math.cos(t * 4.2 - frac * 0.9) * (h * 0.018)
            py = base_y + spread + wave
            if prev is not None:
                draw_line(prev[0], prev[1], px, py, (36, 152, 240), alpha_line)
            if s % 18 == 0:
                draw_node(px, py, 1.7, (130, 218, 255), min(255, alpha_line + 80))
            prev = (px, py)

    # 3. Constelacao poligonal no canto inferior direito
    nodes = [
        (w * 0.71, h * 0.89),
        (w * 0.74, h * 0.74),
        (w * 0.80, h * 0.73),
        (w * 0.85, h * 0.82),
        (w * 0.84, h * 0.94),
        (w * 0.92, h * 0.72),
        (w * 0.98, h * 0.83),
        (w * 0.95, h * 0.93),
    ]
    edges = [
        (0, 1), (0, 3), (0, 4),
        (1, 2), (1, 3),
        (2, 3), (2, 5),
        (3, 4), (3, 5), (3, 6), (3, 7),
        (4, 7),
        (5, 6),
        (6, 7),
    ]
    for i, j in edges:
        draw_line(nodes[i][0], nodes[i][1], nodes[j][0], nodes[j][1], (48, 165, 245), 95)
    for nx, ny in nodes:
        draw_node(nx, ny, 3.8, (40, 155, 245), 90)
        draw_node(nx, ny, 2.0, (215, 245, 255), 240)

    return buf

def render_minimal_bootloader_backdrop(w, h):
    buf = bytearray(w * h * 4)
    cx, cy = w * 0.50, 74.0
    max_r = 210.0

    for y in range(h):
        ty = y / max(1, h - 1)
        br = lerp(4, 8, ty)
        bg = lerp(9, 16, ty)
        bb = lerp(22, 36, ty)
        row = y * w * 4
        dy = (y - cy) * 1.15
        for x in range(w):
            dist = math.hypot((x - cx) * 0.85, dy) / max_r
            glow = max(0.0, 1.0 - dist) ** 2.4
            r = min(255, int(br + 14 * glow))
            g = min(255, int(bg + 52 * glow))
            b = min(255, int(bb + 105 * glow))
            idx = row + x * 4
            buf[idx:idx+4] = bytes((r, g, b, 255))

    def add_px(px, py, sr, sg, sb, sa):
        ix, iy = int(px), int(py)
        if 0 <= ix < w and 0 <= iy < h and sa > 0:
            idx = (iy * w + ix) * 4
            buf[idx]     = min(255, buf[idx]     + (sr * sa) // 255)
            buf[idx + 1] = min(255, buf[idx + 1] + (sg * sa) // 255)
            buf[idx + 2] = min(255, buf[idx + 2] + (sb * sa) // 255)

    for k in range(2):
        alpha = 42 - k * 14
        for s in range(360):
            t = s / 359.0
            px = w * (0.64 + 0.38 * t)
            py = h * (1.02 - 0.22 * (t ** 1.45)) + k * 7
            add_px(px, py, 56, 189, 248, alpha)
            px2 = w * (-0.02 + 0.34 * t)
            py2 = h * (0.20 * ((1.0 - t) ** 1.45)) - k * 7
            add_px(px2, py2, 56, 189, 248, alpha)

    return buf

theme_dir = "/usr/share/plymouth/themes/eonluxos"
assets_dir = "/usr/share/eonluxos"
os.makedirs(theme_dir, exist_ok=True)
os.makedirs(assets_dir, exist_ok=True)

# 2a. Trilho e preenchimento da barra de progresso do Plymouth
tw, th = 340, 6
track = bytearray(tw * th * 4)
for y in range(th):
    for x in range(tw):
        idx = (y * tw + x) * 4
        track[idx:idx+4] = bytes((22, 38, 72, 255))
write_png_rgba(os.path.join(theme_dir, "progress-track.png"), tw, th, track)

fw, fh = 340, 6
fill = bytearray(fw * fh * 4)
for y in range(fh):
    for x in range(fw):
        t = x / max(1, fw - 1)
        r = lerp(19, 56, t)
        g = lerp(127, 189, t)
        b = lerp(236, 248, t)
        idx = (y * fw + x) * 4
        fill[idx:idx+4] = bytes((r, g, b, 255))
write_png_rgba(os.path.join(theme_dir, "progress-fill.png"), fw, fh, fill)

# 2b. Emblema orbital 96x96 (gera fallback caso emblema oficial nao esteja presente)
emblem_path = os.path.join(theme_dir, "emblem.png")
if not os.path.exists(emblem_path):
    w, h = 96, 96
    cx, cy = (w - 1) / 2.0, (h - 1) / 2.0
    buf = bytearray(w * h * 4)
    px_core = bytes((56, 189, 248, 255))
    px_ring = bytes((19, 127, 236, 255))
    px_arc  = bytes((56, 189, 248, 204))
    for y in range(h):
        for x in range(w):
            dx, dy = x - cx, y - cy
            dist = math.hypot(dx, dy)
            idx = (y * w + x) * 4
            if dist <= 10.0:
                buf[idx:idx+4] = px_core
            elif 26.0 <= dist <= 29.5:
                buf[idx:idx+4] = px_ring
            elif 38.0 <= dist <= 40.5 and (dx + dy) > -18:
                buf[idx:idx+4] = px_arc
    write_png_rgba(emblem_path, w, h, buf)

# 2c. Fundo rico do Plymouth (1024x600 com ondas luminosas + constelacao)
ply_bg = render_plymouth_backdrop(1024, 600)
write_png_rgba(os.path.join(theme_dir, "plymouth-bg.png"), 1024, 600, ply_bg)

# 2d. Arte minimalista do Bootloader (640x480 RGB 24-bit sem alfa para ISOLINUX e GRUB)
W, H = 640, 480
canvas = render_minimal_bootloader_backdrop(W, H)

def blend_rect(x0, y0, rw, rh, rgba):
    sr, sg, sb, sa = rgba
    inv = 255 - sa
    for y in range(max(0, y0), min(H, y0 + rh)):
        row = y * W * 4
        for x in range(max(0, x0), min(W, x0 + rw)):
            idx = row + x * 4
            canvas[idx]     = (sr * sa + canvas[idx]     * inv) // 255
            canvas[idx + 1] = (sg * sa + canvas[idx + 1] * inv) // 255
            canvas[idx + 2] = (sb * sa + canvas[idx + 2] * inv) // 255
            canvas[idx + 3] = 255

# Filete superior luminoso (#137FEC -> #38BDF8 -> #137FEC)
for x in range(W):
    t = 1.0 - abs((x / (W - 1)) * 2.0 - 1.0)
    r = lerp(19, 56, t)
    g = lerp(127, 189, t)
    b = lerp(236, 248, t)
    blend_rect(x, 0, 1, 2, (r, g, b, 255))

# Cartao central minimalista (#0B162E) com borda fina #1E4E9C
cx0, cy0, cw, ch = 68, 148, W - 136, 254
blend_rect(cx0 + 2, cy0 + 2, cw - 4, ch - 4, (11, 22, 46, 225))
blend_rect(cx0 + 4, cy0, cw - 8, 1, (42, 132, 238, 255))
blend_rect(cx0 + 4, cy0 + ch - 1, cw - 8, 1, (26, 64, 128, 255))
blend_rect(cx0, cy0 + 4, 1, ch - 8, (26, 64, 128, 255))
blend_rect(cx0 + cw - 1, cy0 + 4, 1, ch - 8, (26, 64, 128, 255))
for dx, dy in [
    (1,1), (2,1), (1,2),
    (cw-2,1), (cw-3,1), (cw-2,2),
    (1,ch-2), (2,ch-2), (1,ch-3),
    (cw-2,ch-2), (cw-3,ch-2), (cw-2,ch-3),
]:
    blend_rect(cx0 + dx, cy0 + dy, 1, 1, (42, 132, 238, 255))

# Compoe o logotipo oficial do EonluxOS centralizado acima do cartao
logo_loaded = None
for logo_candidate in (
    "/usr/share/icons/hicolor/128x128/apps/eonluxos-logo.png",
    "/usr/share/icons/hicolor/96x96/apps/eonluxos-logo.png",
    emblem_path,
):
    logo_loaded = read_png_rgba(logo_candidate)
    if logo_loaded:
        break

if logo_loaded:
    lw, lh, lbuf = logo_loaded
    if lw != 88 or lh != 88:
        lbuf = resize_rgba(lw, lh, lbuf, 88, 88)
        lw, lh = 88, 88
    ox = (W - lw) // 2
    oy = 30
    for y in range(lh):
        dy = oy + y
        if dy < 0 or dy >= H:
            continue
        for x in range(lw):
            dx = ox + x
            if dx < 0 or dx >= W:
                continue
            sidx = (y * lw + x) * 4
            alpha = lbuf[sidx + 3]
            if alpha == 0:
                continue
            didx = (dy * W + dx) * 4
            inv = 255 - alpha
            canvas[didx]     = (lbuf[sidx]     * alpha + canvas[didx]     * inv) // 255
            canvas[didx + 1] = (lbuf[sidx + 1] * alpha + canvas[didx + 1] * inv) // 255
            canvas[didx + 2] = (lbuf[sidx + 2] * alpha + canvas[didx + 2] * inv) // 255
            canvas[didx + 3] = 255

write_png_rgb24(os.path.join(assets_dir, "eonlux-splash.png"), W, H, canvas)
write_png_rgb24(os.path.join(theme_dir, "eonlux-splash.png"), W, H, canvas)
PY

# 3. Remover overrides antigos de unidades systemd que causavam deadlock no boot
rm -rf /etc/systemd/system/plymouth-quit.service.d
rm -rf /etc/systemd/system/plymouth-quit-wait.service.d
rm -rf /etc/systemd/system/lightdm.service.d
rm -f /etc/lightdm/lightdm.conf.d/50-eonluxos-plymouth.conf

# 4. Configurar permissoes do Xorg (Xwrapper) e drop-in limpo do LightDM no vt7
mkdir -p /etc/X11 /etc/lightdm/lightdm.conf.d
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager

cat <<'EOF' > /etc/X11/Xwrapper.config
allowed_users=anybody
needs_root_rights=yes
EOF
chmod 0644 /etc/X11/Xwrapper.config

cat <<'EOF' > /etc/lightdm/lightdm.conf.d/50-eonluxos-autologin.conf
[LightDM]
minimum-vt=7

[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
autologin-user=user
autologin-user-timeout=0
EOF
chmod 0644 /etc/lightdm/lightdm.conf.d/50-eonluxos-autologin.conf

systemctl unmask getty@tty1.service || true
systemctl set-default graphical.target || true
systemctl enable lightdm.service || true

# 5. Configurar Plymouth no initramfs com FRAMEBUFFER=y e modulos KMS
mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/eonluxos-plymouth

for mod in i915 amdgpu radeon nouveau vmwgfx virtio_gpu bochs simpledrm; do
    grep -qx "$mod" /etc/initramfs-tools/modules 2>/dev/null || echo "$mod" >> /etc/initramfs-tools/modules
done

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R eonluxos || update-initramfs -u -k all
elif command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all
fi
