#!/bin/sh

set -e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

echo "[EonluxOS Hook] Configurando permissões visuais, wallpaper global e tema Plymouth..."

chmod +x /usr/local/bin/eonluxos-apply-defaults.sh || true

mkdir -p /usr/share/backgrounds/xfce
ln -sf /usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg /usr/share/backgrounds/xfce/xfce-stripes.png
ln -sf /usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg /usr/share/backgrounds/xfce/xfce-verticals.png

THEME_DIR="/usr/share/plymouth/themes/eonluxos"
if [ -d "$THEME_DIR" ]; then
    python3 - << 'EOF'
from PIL import Image, ImageDraw
import os

theme_dir = "/usr/share/plymouth/themes/eonluxos"
png_path = os.path.join(theme_dir, "eonlux-logo.png")
jpg_path = os.path.join(theme_dir, "eonlux-logo.jpg")

src_path = png_path if os.path.exists(png_path) else (jpg_path if os.path.exists(jpg_path) else None)

if src_path:
    img = Image.open(src_path).convert("RGBA")
    target_w = 680
    if img.width != target_w:
        ratio = target_w / float(img.width)
        img = img.resize((target_w, int(img.height * ratio)), Image.Resampling.LANCZOS)
    img.save(png_path, "PNG")
else:
    img = Image.new("RGBA", (480, 140), (6, 12, 28, 255))
    draw = ImageDraw.Draw(img)
    draw.text((195, 52), "Eonlux Core", fill=(230, 240, 255, 255))
    draw.text((125, 82), "Novas Possibilidades para grandes historias", fill=(140, 180, 230, 255))
    img.save(png_path, "PNG")

# Moldura da barra de progresso (360x10 px)
box = Image.new("RGBA", (360, 10), (16, 28, 52, 255))
draw_box = ImageDraw.Draw(box)
draw_box.rectangle([0, 0, 359, 9], outline=(56, 139, 253, 255), width=1)
box.save(os.path.join(theme_dir, "progress_box.png"), "PNG")

# Preenchimento azul da barra de progresso (356x6 px)
bar = Image.new("RGBA", (356, 6), (19, 127, 236, 255))
bar.save(os.path.join(theme_dir, "progress_bar.png"), "PNG")
EOF

    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "${THEME_DIR}/eonluxos.plymouth" 200
    update-alternatives --set default.plymouth "${THEME_DIR}/eonluxos.plymouth"
    plymouth-set-default-theme -R eonluxos || update-initramfs -u -k all || true
fi

chown -R root:root /etc/skel
