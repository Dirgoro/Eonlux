#!/bin/sh
set -eu

# 1. Normaliza quebras de linha (CRLF -> LF) em todos os arquivos customizados
find /etc/skel /etc/xdg /etc/plymouth /usr/share/plymouth /usr/local/bin -type f 2>/dev/null | while IFS= read -r file; do
    sed -i 's/\r$//' "$file" 2>/dev/null || true
done

# 2. Garante permissao de execucao nos scripts e sessao X11
chmod +x /usr/local/bin/eonluxos-* 2>/dev/null || true
chmod +x /etc/skel/.xinitrc 2>/dev/null || true

# 3. Gera os ativos PNG (bootloader 640x480 e Plymouth) usando Python3 + PIL no chroot
python3 - <<'PY'
import math
import os
import random
from PIL import Image, ImageDraw, ImageFilter, ImageFont

BG = (6, 12, 28)          # #060C1C
ACCENT = (19, 127, 236)   # #137FEC
GLOW = (56, 189, 248)     # #38BDF8
WHITE = (255, 255, 255)
TEXT_SOFT = (226, 232, 240)

def load_font(size, bold=True):
    candidates = (
        [
            "/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        ]
        if bold
        else [
            "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        ]
    )
    for path in candidates:
        if os.path.exists(path):
            return ImageFont.truetype(path, size)
    return ImageFont.load_default()

def draw_emblem(base_rgba, cx, cy, r):
    glow_layer = Image.new("RGBA", base_rgba.size, (0, 0, 0, 0))
    dg = ImageDraw.Draw(glow_layer)
    dg.ellipse((cx - r - 18, cy - r - 18, cx + r + 18, cy + r + 18), fill=(19, 127, 236, 55))
    dg.ellipse((cx - r - 6, cy - r - 6, cx + r + 6, cy + r + 6), outline=(56, 189, 248, 150), width=4)
    glow_layer = glow_layer.filter(ImageFilter.GaussianBlur(6))
    base_rgba.alpha_composite(glow_layer)

    d = ImageDraw.Draw(base_rgba)
    # Aneis orbitais externos e internos
    d.arc((cx - r - 10, cy - r - 10, cx + r + 10, cy + r + 10), start=120, end=330, fill=(56, 189, 248, 190), width=2)
    d.arc((cx - r, cy - r, cx + r, cy + r), start=35, end=315, fill=(19, 127, 236, 255), width=5)
    inner = int(r * 0.64)
    d.arc((cx - inner, cy - inner, cx + inner, cy + inner), start=20, end=300, fill=(56, 189, 248, 235), width=3)
    # Nucleo luminoso
    core = int(r * 0.28)
    d.ellipse((cx - core - 4, cy - core - 4, cx + core + 4, cy + core + 4), fill=(56, 189, 248, 90))
    d.ellipse((cx - core, cy - core, cx + core, cy + core), fill=(224, 242, 254, 255))
    # Satelites orbitais
    for deg in (225, 325, 145):
        rad = math.radians(deg)
        sx = int(cx + (r + 10) * math.cos(rad))
        sy = int(cy + (r + 10) * math.sin(rad))
        d.ellipse((sx - 3, sy - 3, sx + 3, sy + 3), fill=(125, 211, 252, 255))

def build_bootloader_splash(out_path):
    W, H = 640, 480
    canvas = Image.new("RGBA", (W, H), (*BG, 255))

    # 1. Luzes ambientais radiais (canto superior esquerdo e inferior direito)
    ambient = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    da = ImageDraw.Draw(ambient)
    da.ellipse((-40, -30, 260, 240), fill=(19, 127, 236, 58))
    da.ellipse((380, 260, 700, 540), fill=(14, 165, 233, 52))
    da.ellipse((420, -20, 680, 220), fill=(19, 127, 236, 36))
    ambient = ambient.filter(ImageFilter.GaussianBlur(38))
    canvas.alpha_composite(ambient)

    # 2. Ondas de particulas e malha poligonal futurista
    fx = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    df = ImageDraw.Draw(fx)
    random.seed(42)

    # Onda superior direita
    for wave in range(7):
        pts = []
        for x in range(340, 645, 10):
            t = (x - 340) / 300.0
            y = 145 - (t * 95) + math.sin(t * 4.2 + wave * 0.45) * (16 + wave * 2) + wave * 6
            pts.append((x, y))
        for idx in range(len(pts) - 1):
            alpha = int(35 + (idx / len(pts)) * 95)
            df.line([pts[idx], pts[idx + 1]], fill=(56, 189, 248, alpha), width=1)
        for px, py in pts[::2]:
            df.ellipse((px - 1, py - 1, px + 1, py + 1), fill=(186, 230, 253, 170))

    # Onda inferior esquerda -> centro
    for wave in range(8):
        pts = []
        for x in range(-10, 430, 12):
            t = (x + 10) / 440.0
            y = 435 - (t * 85) + math.sin(t * 4.8 + wave * 0.4) * (18 + wave * 2) + wave * 5
            pts.append((x, y))
        for idx in range(len(pts) - 1):
            alpha = int(95 - (idx / len(pts)) * 65)
            df.line([pts[idx], pts[idx + 1]], fill=(19, 127, 236, max(20, alpha)), width=1)
        for px, py in pts[::2]:
            df.ellipse((px - 1, py - 1, px + 1, py + 1), fill=(125, 211, 252, 150))

    # Constelacao poligonal no canto inferior direito
    nodes = [
        (450, 445), (495, 395), (545, 420), (590, 365), (628, 410),
        (520, 468), (575, 455), (625, 465), (470, 355), (540, 345),
    ]
    for i in range(len(nodes)):
        for j in range(i + 1, len(nodes)):
            dist = math.hypot(nodes[i][0] - nodes[j][0], nodes[i][1] - nodes[j][1])
            if dist < 95:
                df.line([nodes[i], nodes[j]], fill=(56, 189, 248, 85), width=1)
    for nx, ny in nodes:
        df.ellipse((nx - 4, ny - 4, nx + 4, ny + 4), fill=(56, 189, 248, 70))
        df.ellipse((nx - 2, ny - 2, nx + 2, ny + 2), fill=(224, 242, 254, 230))

    # Particulas flutuantes sutis
    for _ in range(45):
        px = random.randint(20, 620)
        py = random.randint(20, 460)
        if 85 <= px <= 555 and 188 <= py <= 378:
            continue
        r_dot = random.choice([1, 1, 2])
        df.ellipse((px - r_dot, py - r_dot, px + r_dot, py + r_dot), fill=(186, 230, 253, random.randint(90, 200)))

    canvas.alpha_composite(fx)

    # 3. Logo EonluxOS 1.0 Core no topo esquerdo
    draw_emblem(canvas, 78, 84, 34)
    d = ImageDraw.Draw(canvas)
    f_brand = load_font(22, bold=True)
    f_sub = load_font(14, bold=True)
    d.text((126, 62), "EonluxOS", fill=WHITE, font=f_brand)
    d.text((146, 90), "1.0 Core", fill=GLOW, font=f_sub)

    # 4. Frase motivacional no topo direito
    f_mot1 = load_font(14, bold=True)
    f_mot2 = load_font(13, bold=False)
    line1 = "Dê uma nova vida ao seu computador."
    line2 = "Leve, rápido e livre de verdade!"
    b1 = d.textbbox((0, 0), line1, font=f_mot1)
    b2 = d.textbbox((0, 0), line2, font=f_mot2)
    d.text((612 - (b1[2] - b1[0]), 64), line1, fill=WHITE, font=f_mot1)
    d.text((612 - (b2[2] - b2[0]), 86), line2, fill=TEXT_SOFT, font=f_mot2)

    # 5. Cartao central estilo glassmorphism (alinhado exatamente com vesamenu.c32)
    panel = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    dp = ImageDraw.Draw(panel)
    box = (86, 190, 554, 374)
    dp.rounded_rectangle(box, radius=14, fill=(8, 18, 42, 210), outline=(56, 189, 248, 220), width=2)
    # Linha divisoria abaixo do titulo do menu (y=232)
    dp.line([(88, 232), (552, 232)], fill=(56, 189, 248, 140), width=1)
    canvas.alpha_composite(panel)

    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    canvas.convert("RGB").save(out_path, "PNG")

build_bootloader_splash("/usr/share/eonluxos/eonlux-splash.png")

# Ativos Plymouth
ply_dir = "/usr/share/plymouth/themes/eonluxos"
if os.path.isdir(ply_dir):
    logo = Image.new("RGBA", (160, 160), (0, 0, 0, 0))
    draw_emblem(logo, 80, 80, 56)
    logo.save(os.path.join(ply_dir, "logo.png"), "PNG")

    bar_bg = Image.new("RGBA", (360, 8), (15, 23, 42, 220))
    bar_bg.save(os.path.join(ply_dir, "progress_box.png"), "PNG")

    bar_fg = Image.new("RGBA", (360, 8), (19, 127, 236, 255))
    bar_fg.save(os.path.join(ply_dir, "progress_bar.png"), "PNG")
PY

# 4. Configura Plymouth como tema padrao e inclui framebuffer no initramfs
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme eonluxos || true
fi

mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/splash

# 5. Evita apenas o getty@tty1 para nao sujar o Plymouth durante o boot
systemctl mask getty@tty1.service 2>/dev/null || true
rm -f /etc/systemd/system/plymouth-quit.service /etc/systemd/system/plymouth-quit-wait.service

# 6. Permite que o usuario live inicie o Xorg diretamente no tty2
mkdir -p /etc/X11
cat <<'EOF' > /etc/X11/Xwrapper.config
allowed_users=anybody
needs_root_rights=yes
EOF

# 7. Atualiza cache de icones GTK e reconstroi o initramfs
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

update-initramfs -u -k all 2>/dev/null || true
