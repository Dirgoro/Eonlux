#!/bin/sh

set -e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

echo "[EonluxOS Hook] Registrando ícones, wallpaper padrão e ativos do Plymouth..."

find /usr/local/bin /etc/skel -type f -exec sed -i 's/\r$//' {} + 2>/dev/null || true
chmod +x /usr/local/bin/*.sh 2>/dev/null || true
chmod 0440 /etc/sudoers.d/eonluxos-boot 2>/dev/null || true

systemctl mask getty@tty1.service 2>/dev/null || true
systemctl enable NetworkManager.service 2>/dev/null || true
systemctl enable bluetooth.service 2>/dev/null || true

LOGO_SVG="/usr/share/icons/hicolor/scalable/apps/eonluxos-logo.svg"
if [ -f "$LOGO_SVG" ]; then
    cp -f "$LOGO_SVG" /usr/share/pixmaps/eonluxos-logo.svg
    if command -v rsvg-convert >/dev/null 2>&1; then
        mkdir -p /usr/share/icons/hicolor/24x24/apps /usr/share/icons/hicolor/48x48/apps /usr/share/icons/hicolor/128x128/apps
        rsvg-convert -w 24 -h 24 "$LOGO_SVG" -o /usr/share/icons/hicolor/24x24/apps/eonluxos-logo.png
        rsvg-convert -w 48 -h 48 "$LOGO_SVG" -o /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png
        rsvg-convert -w 128 -h 128 "$LOGO_SVG" -o /usr/share/icons/hicolor/128x128/apps/eonluxos-logo.png
        cp -f /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png /usr/share/pixmaps/eonluxos-logo.png
    fi
fi

gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/Papirus-Dark 2>/dev/null || true

WALLPAPER="/usr/share/backgrounds/eonluxos/eonlux-wallpaper.jpg"
if [ -f "$WALLPAPER" ]; then
    mkdir -p /usr/share/backgrounds/xfce /usr/share/images/desktop-base
    ln -sf "$WALLPAPER" /usr/share/backgrounds/xfce/xfce-stripes.png
    ln -sf "$WALLPAPER" /usr/share/backgrounds/xfce/xfce-verticals.png
    ln -sf "$WALLPAPER" /usr/share/backgrounds/xfce/xfce-shapes.svg
    ln -sf "$WALLPAPER" /usr/share/images/desktop-base/default
fi

THEME_DIR="/usr/share/plymouth/themes/eonluxos"
BRAND_SVG="/usr/share/pixmaps/eonluxos-brand.svg"

if [ -d "$THEME_DIR" ]; then
    if [ -f "$LOGO_SVG" ] && command -v rsvg-convert >/dev/null 2>&1; then
        rsvg-convert -w 136 "$LOGO_SVG" -o "${THEME_DIR}/stage2-emblem.png"
    fi
    if [ -f "$BRAND_SVG" ] && command -v rsvg-convert >/dev/null 2>&1; then
        rsvg-convert -w 540 "$BRAND_SVG" -o "${THEME_DIR}/stage3-brand-raw.png"
    fi

    python3 - << 'EOF'
from PIL import Image, ImageDraw, ImageFont
import os

theme_dir = "/usr/share/plymouth/themes/eonluxos"

raw_brand = os.path.join(theme_dir, "stage3-brand-raw.png")
if os.path.exists(raw_brand):
    im = Image.open(raw_brand).convert("RGBA")
    crop_h = int(im.height * 0.74)
    im.crop((0, 0, im.width, crop_h)).save(os.path.join(theme_dir, "stage3-brand.png"), "PNG")

box = Image.new("RGBA", (360, 6), (26, 39, 64, 255))
box.save(os.path.join(theme_dir, "progress_box.png"), "PNG")

bar = Image.new("RGBA", (360, 6), (19, 127, 236, 255))
bar.save(os.path.join(theme_dir, "progress_bar.png"), "PNG")

cap = Image.new("RGBA", (620, 74), (0, 0, 0, 0))
draw = ImageDraw.Draw(cap)
try:
    f_bold = ImageFont.truetype("/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf", 19)
    f_reg = ImageFont.truetype("/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf", 14)
except Exception:
    f_bold = ImageFont.load_default()
    f_reg = ImageFont.load_default()

t1 = "Seu equipamento ganhando nova vida..."
t2 = "Otimizando desempenho, memória e interface para você"

w1 = draw.textbbox((0, 0), t1, font=f_bold)[2]
w2 = draw.textbbox((0, 0), t2, font=f_reg)[2]

draw.text(((620 - w1) // 2, 6), t1, font=f_bold, fill=(240, 246, 255, 255))
draw.text(((620 - w2) // 2, 38), t2, font=f_reg, fill=(168, 184, 208, 255))
cap.save(os.path.join(theme_dir, "stage3-caption.png"), "PNG")
EOF

    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "${THEME_DIR}/eonluxos.plymouth" 200
    update-alternatives --set default.plymouth "${THEME_DIR}/eonluxos.plymouth"
    plymouth-set-default-theme -R eonluxos || update-initramfs -u -k all || true
fi

chown -R root:root /etc/skel
