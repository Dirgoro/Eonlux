#!/bin/sh
set -eu

# 1. Normaliza quebras de linha (CRLF -> LF) em todos os ficheiros customizados
find /etc/skel /etc/xdg /etc/plymouth /usr/share/plymouth /usr/local/bin -type f 2>/dev/null | while IFS= read -r file; do
    sed -i 's/\r$//' "$file" 2>/dev/null || true
done

# 2. Garante permissao de execucao nos scripts e silencia banners no autologin
chmod +x /usr/local/bin/eonluxos-* 2>/dev/null || true
chmod +x /etc/skel/.xinitrc 2>/dev/null || true
touch /etc/skel/.hushlogin
: > /etc/issue
: > /etc/issue.net

# 3. Rasteriza o logotipo oficial eonluxos-logo.svg para icones, Plymouth e Bootloader
SVG_LOGO="/usr/share/icons/hicolor/scalable/apps/eonluxos-logo.svg"
PLY_DIR="/usr/share/plymouth/themes/eonluxos"

mkdir -p \
    /usr/share/icons/hicolor/24x24/apps \
    /usr/share/icons/hicolor/48x48/apps \
    /usr/share/pixmaps \
    "$PLY_DIR"

if [ -f "$SVG_LOGO" ]; then
    chmod 0644 "$SVG_LOGO"
    if command -v rsvg-convert >/dev/null 2>&1; then
        rsvg-convert -w 24 -h 24 "$SVG_LOGO" -o /usr/share/icons/hicolor/24x24/apps/eonluxos-logo.png
        rsvg-convert -w 48 -h 48 "$SVG_LOGO" -o /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png
        rsvg-convert -w 136 -h 136 "$SVG_LOGO" -o "${PLY_DIR}/logo.png"
        rsvg-convert -w 68 -h 68 "$SVG_LOGO" -o /tmp/eonluxos-logo-68.png
    else
        python3 - <<'PYSVG' || true
import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf

svg = "/usr/share/icons/hicolor/scalable/apps/eonluxos-logo.svg"
targets = [
    (24, "/usr/share/icons/hicolor/24x24/apps/eonluxos-logo.png"),
    (48, "/usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png"),
    (136, "/usr/share/plymouth/themes/eonluxos/logo.png"),
    (68, "/tmp/eonluxos-logo-68.png"),
]
for size, out in targets:
    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(svg, size, size, True)
    pb.savev(out, "png", [], [])
PYSVG
    fi
    if [ -f /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png ]; then
        cp -f /usr/share/icons/hicolor/48x48/apps/eonluxos-logo.png /usr/share/pixmaps/eonluxos-logo.png
    fi
fi

# 4. Gera os ativos graficos em Python 3 puro:
#    - Bootloader (640x480 RGB 24-bit com a logo oficial composta)
#    - Plymouth background.png (1280x800 moderno na paleta #060C1C / #137FEC / #38BDF8)
#    - Barras de progresso do Plymouth (progress_box.png e progress_bar.png)
python3 - <<'PY'
import math
import os
import struct
import zlib

FONT_5X7 = {
    " ": ["00000","00000","00000","00000","00000","00000","00000"],
    "!": ["00100","00100","00100","00100","00100","00000","00100"],
    ",": ["00000","00000","00000","00000","00100","00100","01000"],
    ".": ["00000","00000","00000","00000","00000","01100","01100"],
    "0": ["01110","10001","10011","10101","11001","10001","01110"],
    "1": ["00100","01100","00100","00100","00100","00100","01110"],
    "C": ["01110","10001","10000","10000","10000","10001","01110"],
    "D": ["11100","10010","10001","10001","10001","10010","11100"],
    "E": ["11111","10000","10000","11110","10000","10000","11111"],
    "L": ["10000","10000","10000","10000","10000","10000","11111"],
    "O": ["01110","10001","10001","10001","10001","10001","01110"],
    "S": ["01111","10000","10000","01110","00001","00001","11110"],
    "a": ["00000","00000","01110","00001","01111","10001","01111"],
    "c": ["00000","00000","01110","10000","10000","10001","01110"],
    "d": ["00001","00001","01101","10011","10001","10001","01111"],
    "e": ["00000","00000","01110","10001","11111","10000","01110"],
    "ê": ["00100","01010","01110","10001","11111","10000","01110"],
    "i": ["00100","00000","01100","00100","00100","00100","01110"],
    "l": ["01100","00100","00100","00100","00100","00100","01110"],
    "m": ["00000","00000","11010","10101","10101","10001","10001"],
    "n": ["00000","00000","10110","11001","10001","10001","10001"],
    "o": ["00000","00000","01110","10001","10001","10001","01110"],
    "p": ["00000","00000","11110","10001","11110","10000","10000"],
    "r": ["00000","00000","10110","11001","10000","10000","10000"],
    "á": ["00010","00100","01110","00001","01111","10001","01111"],
    "s": ["00000","00000","01111","10000","01110","00001","11110"],
    "t": ["01000","01000","11100","01000","01000","01001","00110"],
    "u": ["00000","00000","10001","10001","10001","10011","01101"],
    "v": ["00000","00000","10001","10001","10001","01010","00100"],
    "x": ["00000","00000","10001","01010","00100","01010","10001"],
}

def clamp_byte(v):
    return 0 if v < 0 else (255 if v > 255 else int(v))

def _write_png(path, w, h, color_type, raw_rows):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    def chunk(tag, data):
        return struct.pack("!I", len(data)) + tag + data + struct.pack("!I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    ihdr = struct.pack("!IIBBBBB", w, h, 8, color_type, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(bytes(raw_rows), 6)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def save_png_rgb(path, w, h, buf_rgba):
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        row_start = y * w * 4
        for x in range(w):
            i = row_start + x * 4
            raw.append(buf_rgba[i])
            raw.append(buf_rgba[i + 1])
            raw.append(buf_rgba[i + 2])
    _write_png(path, w, h, 2, raw)

def save_png_rgba(path, w, h, buf_rgba):
    raw = bytearray()
    stride = w * 4
    for y in range(h):
        raw.append(0)
        raw.extend(buf_rgba[y * stride : (y + 1) * stride])
    _write_png(path, w, h, 6, raw)

def read_png_rgba(path):
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    pos = 8
    w = h = bit_depth = color_type = 0
    idat = bytearray()
    while pos < len(data):
        length = struct.unpack(">I", data[pos:pos+4])[0]
        ctype = data[pos+4:pos+8]
        chunk_data = data[pos+8:pos+8+length]
        pos += 12 + length
        if ctype == b"IHDR":
            w, h, bit_depth, color_type, _, _, _ = struct.unpack(">IIBBBBB", chunk_data)
        elif ctype == b"IDAT":
            idat.extend(chunk_data)
        elif ctype == b"IEND":
            break
    if bit_depth != 8 or color_type not in (2, 6):
        return None
    bpp = 4 if color_type == 6 else 3
    raw = zlib.decompress(bytes(idat))
    stride = w * bpp
    recon = bytearray(h * stride)
    in_pos = 0
    for y in range(h):
        ftype = raw[in_pos]
        in_pos += 1
        row_start = y * stride
        for i in range(stride):
            x = raw[in_pos + i]
            a = recon[row_start + i - bpp] if i >= bpp else 0
            b = recon[row_start - stride + i] if y > 0 else 0
            c = recon[row_start - stride + i - bpp] if (y > 0 and i >= bpp) else 0
            if ftype == 0:
                val = x
            elif ftype == 1:
                val = (x + a) & 0xff
            elif ftype == 2:
                val = (x + b) & 0xff
            elif ftype == 3:
                val = (x + ((a + b) >> 1)) & 0xff
            elif ftype == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)
                val = (x + pr) & 0xff
            else:
                val = x
            recon[row_start + i] = val
        in_pos += stride
    out = bytearray(w * h * 4)
    if bpp == 4:
        out[:] = recon
    else:
        for i in range(w * h):
            out[i*4:i*4+3] = recon[i*3:i*3+3]
            out[i*4+3] = 255
    return w, h, out

def blend_px(buf, w, h, x, y, r, g, b, a):
    if x < 0 or y < 0 or x >= w or y >= h or a <= 0:
        return
    idx = (y * w + x) * 4
    if a >= 255:
        buf[idx] = clamp_byte(r)
        buf[idx + 1] = clamp_byte(g)
        buf[idx + 2] = clamp_byte(b)
        buf[idx + 3] = 255
        return
    inv = 255 - a
    oa = buf[idx + 3]
    out_a = a + (oa * inv) // 255
    if out_a <= 0:
        return
    buf[idx] = clamp_byte((r * a + buf[idx] * oa * inv // 255) // out_a)
    buf[idx + 1] = clamp_byte((g * a + buf[idx + 1] * oa * inv // 255) // out_a)
    buf[idx + 2] = clamp_byte((b * a + buf[idx + 2] * oa * inv // 255) // out_a)
    buf[idx + 3] = clamp_byte(out_a)

def blit_rgba(dst, dw, dh, src_tuple, ox, oy):
    sw, sh, sbuf = src_tuple
    for y in range(sh):
        dy = oy + y
        if dy < 0 or dy >= dh:
            continue
        for x in range(sw):
            dx = ox + x
            if dx < 0 or dx >= dw:
                continue
            si = (y * sw + x) * 4
            a = sbuf[si + 3]
            if a > 0:
                blend_px(dst, dw, dh, dx, dy, sbuf[si], sbuf[si + 1], sbuf[si + 2], a)

def draw_circle(buf, w, h, cx, cy, rad, col, fill=False, width=2):
    r2_out = (rad + width * 0.5) ** 2
    r2_in = max(0.0, (rad - width * 0.5)) ** 2
    x0, x1 = max(0, int(cx - rad - width - 2)), min(w - 1, int(cx + rad + width + 2))
    y0, y1 = max(0, int(cy - rad - width - 2)), min(h - 1, int(cy + rad + width + 2))
    for y in range(y0, y1 + 1):
        dy2 = (y - cy) ** 2
        for x in range(x0, x1 + 1):
            d2 = (x - cx) ** 2 + dy2
            if fill:
                if d2 <= rad * rad:
                    blend_px(buf, w, h, x, y, *col)
            else:
                if r2_in <= d2 <= r2_out:
                    blend_px(buf, w, h, x, y, *col)

def draw_line(buf, w, h, x0, y0, x1, y1, col):
    steps = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    for i in range(steps + 1):
        t = i / max(1, steps)
        blend_px(buf, w, h, int(round(x0 + (x1 - x0) * t)), int(round(y0 + (y1 - y0) * t)), *col)

def draw_text(buf, w, h, x, y, text, scale, col):
    cx = x
    for ch in text:
        glyph = FONT_5X7.get(ch, FONT_5X7[" "])
        for row_i, row in enumerate(glyph):
            for col_i, bit in enumerate(row):
                if bit == "1":
                    for sy in range(scale):
                        for sx in range(scale):
                            blend_px(buf, w, h, cx + col_i * scale + sx, y + row_i * scale + sy, *col)
        cx += 6 * scale

def draw_fallback_emblem(buf, w, h, cx, cy, rad):
    for gr in range(rad + 18, rad, -2):
        alpha = int(32 * (1 - (gr - rad) / 18.0))
        draw_circle(buf, w, h, cx, cy, gr, (19, 127, 236, alpha), fill=True)
    draw_circle(buf, w, h, cx, cy, rad + 9, (56, 189, 248, 190), fill=False, width=2)
    draw_circle(buf, w, h, cx, cy, rad, (19, 127, 236, 255), fill=False, width=4)
    draw_circle(buf, w, h, cx, cy, int(rad * 0.62), (56, 189, 248, 240), fill=False, width=3)
    draw_circle(buf, w, h, cx, cy, int(rad * 0.26), (224, 242, 254, 255), fill=True)

def paint_modern_tech_backdrop(buf, w, h):
    # Brilho radial profundo
    for gr in range(int(min(w, h) * 0.55), 12, -8):
        a = int(14 * (1 - gr / (min(w, h) * 0.55)))
        draw_circle(buf, w, h, int(w * 0.5), int(h * 0.38), gr, (19, 127, 236, a), fill=True)
        draw_circle(buf, w, h, int(w * 0.14), int(h * 0.18), int(gr * 0.7), (56, 189, 248, max(1, a // 2)), fill=True)
        draw_circle(buf, w, h, int(w * 0.88), int(h * 0.85), int(gr * 0.8), (14, 165, 233, max(1, a // 2)), fill=True)

    # Ondas luminosas superiores direitas
    for wave in range(8):
        pts = []
        x_start = int(w * 0.52)
        for x in range(x_start, w + 16, max(10, w // 64)):
            t = (x - x_start) / max(1.0, (w - x_start))
            y = h * 0.30 - t * (h * 0.20) + math.sin(t * 4.4 + wave * 0.42) * (h * 0.038) + wave * (h * 0.012)
            pts.append((x, y))
        for i in range(len(pts) - 1):
            draw_line(buf, w, h, pts[i][0], pts[i][1], pts[i + 1][0], pts[i + 1][1], (56, 189, 248, 82))
        for px, py in pts[::2]:
            draw_circle(buf, w, h, int(px), int(py), 1, (186, 230, 253, 185), fill=True)

    # Ondas luminosas inferiores esquerdas
    for wave in range(9):
        pts = []
        x_end = int(w * 0.66)
        for x in range(-16, x_end, max(10, w // 64)):
            t = (x + 16) / max(1.0, (x_end + 16))
            y = h * 0.91 - t * (h * 0.17) + math.sin(t * 4.6 + wave * 0.38) * (h * 0.036) + wave * (h * 0.010)
            pts.append((x, y))
        for i in range(len(pts) - 1):
            draw_line(buf, w, h, pts[i][0], pts[i][1], pts[i + 1][0], pts[i + 1][1], (19, 127, 236, 78))
        for px, py in pts[::2]:
            draw_circle(buf, w, h, int(px), int(py), 1, (125, 211, 252, 165), fill=True)

    # Constelacao poligonal inferior direita
    rel_nodes = [
        (0.71, 0.92), (0.78, 0.83), (0.85, 0.88), (0.92, 0.77), (0.98, 0.86),
        (0.81, 0.97), (0.90, 0.95), (0.97, 0.96), (0.74, 0.75), (0.85, 0.73),
    ]
    nodes = [(int(nx * w), int(ny * h)) for nx, ny in rel_nodes]
    max_dist = min(w, h) * 0.21
    for i in range(len(nodes)):
        for j in range(i + 1, len(nodes)):
            if math.hypot(nodes[i][0] - nodes[j][0], nodes[i][1] - nodes[j][1]) < max_dist:
                draw_line(buf, w, h, nodes[i][0], nodes[i][1], nodes[j][0], nodes[j][1], (56, 189, 248, 95))
    for nx, ny in nodes:
        draw_circle(buf, w, h, nx, ny, 3, (56, 189, 248, 105), fill=True)
        draw_circle(buf, w, h, nx, ny, 2, (224, 242, 254, 235), fill=True)

# A) Splash do Bootloader (640x480 - RGB 24-bit) com a Logo Oficial
W, H = 640, 480
splash = bytearray([6, 12, 28, 255] * (W * H))
paint_modern_tech_backdrop(splash, W, H)

logo68 = read_png_rgba("/tmp/eonluxos-logo-68.png")
if logo68:
    blit_rgba(splash, W, H, logo68, 42, 50)
else:
    draw_fallback_emblem(splash, W, H, 76, 84, 30)

draw_text(splash, W, H, 122, 62, "EonluxOS", 3, (255, 255, 255, 255))
draw_text(splash, W, H, 140, 92, "1.0 Core", 2, (56, 189, 248, 255))

line1 = "Dê uma nova vida ao seu computador."
line2 = "Leve, rápido e livre de verdade!"
draw_text(splash, W, H, 616 - len(line1) * 6, 68, line1, 1, (255, 255, 255, 255))
draw_text(splash, W, H, 616 - len(line2) * 6, 86, line2, 1, (186, 230, 253, 255))

for y in range(188, 377):
    for x in range(86, 555):
        is_border = (x <= 87 or x >= 553 or y <= 189 or y >= 375 or y == 232)
        if is_border:
            blend_px(splash, W, H, x, y, 56, 189, 248, 225)
        else:
            blend_px(splash, W, H, x, y, 8, 18, 42, 215)

save_png_rgb("/usr/share/eonluxos/eonlux-splash.png", W, H, splash)

# B) Fundo moderno do Plymouth (1280x800 RGBA) + Logo Oficial + Barra
ply_dir = "/usr/share/plymouth/themes/eonluxos"
os.makedirs(ply_dir, exist_ok=True)

PW, PH = 1280, 800
ply_bg = bytearray([6, 12, 28, 255] * (PW * PH))
paint_modern_tech_backdrop(ply_bg, PW, PH)

# Painel central translucido sutil para destacar a logo oficial e a barra de carregamento
card_w, card_h = 560, 380
cx0 = (PW - card_w) // 2
cy0 = (PH - card_h) // 2
cx1 = cx0 + card_w
cy1 = cy0 + card_h

for y in range(cy0, cy1):
    for x in range(cx0, cx1):
        is_edge = (x == cx0 or x == cx1 - 1 or y == cy0 or y == cy1 - 1)
        if is_edge:
            blend_px(ply_bg, PW, PH, x, y, 56, 189, 248, 165)
        else:
            blend_px(ply_bg, PW, PH, x, y, 8, 18, 42, 185)

# Linha superior de destaque neon no cartao central
for y in range(cy0, cy0 + 2):
    for x in range(cx0 + 40, cx1 - 40):
        blend_px(ply_bg, PW, PH, x, y, 56, 189, 248, 240)

save_png_rgba(os.path.join(ply_dir, "background.png"), PW, PH, ply_bg)

# Fallback caso eonluxos-logo.svg nao exista
logo_path = os.path.join(ply_dir, "logo.png")
if not os.path.exists(logo_path):
    logo_fb = bytearray([0, 0, 0, 0] * (136 * 136))
    draw_fallback_emblem(logo_fb, 136, 136, 68, 68, 46)
    save_png_rgba(logo_path, 136, 136, logo_fb)

bar_bg = bytearray([18, 32, 62, 245] * (380 * 8))
save_png_rgba(os.path.join(ply_dir, "progress_box.png"), 380, 8, bar_bg)

bar_fg = bytearray([0] * (380 * 8 * 4))
for y in range(8):
    for x in range(380):
        t = x / 379.0
        i = (y * 380 + x) * 4
        bar_fg[i] = int(19 + (56 - 19) * t)
        bar_fg[i + 1] = int(127 + (189 - 127) * t)
        bar_fg[i + 2] = int(236 + (248 - 236) * t)
        bar_fg[i + 3] = 255
save_png_rgba(os.path.join(ply_dir, "progress_bar.png"), 380, 8, bar_fg)
PY

rm -f /tmp/eonluxos-logo-68.png

# 5. Script do Plymouth com fundo moderno redimensionavel (1024x600 ate Full HD) + Logo Oficial
cat <<'EOF' > /usr/share/plymouth/themes/eonluxos/eonluxos.plymouth
[Plymouth Theme]
Name=EonluxOS
Description=EonluxOS 1.0 Core Boot Splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/eonluxos
ScriptFile=/usr/share/plymouth/themes/eonluxos/eonluxos.script
EOF

cat <<'EOF' > /usr/share/plymouth/themes/eonluxos/eonluxos.script
Window.SetBackgroundTopColor(0.0235, 0.0470, 0.1098);
Window.SetBackgroundBottomColor(0.0235, 0.0470, 0.1098);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

// Fundo moderno escalado proporcionalmente a resolucao real do monitor (EDID)
bg.raw = Image("background.png");
if (bg.raw) {
    bg.image = bg.raw.Scale(screen_w, screen_h);
    bg.sprite = Sprite(bg.image);
    bg.sprite.SetX(0);
    bg.sprite.SetY(0);
    bg.sprite.SetZ(1);
}

// Logotipo oficial do EonluxOS centralizado
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen_h / 2 - 148);
logo.sprite.SetZ(10);

title.image = Image.Text("EonluxOS 1.0 Core", 1.0, 1.0, 1.0, 1.0, "Noto Sans Bold 16");
title.sprite = Sprite(title.image);
title.sprite.SetX(screen_w / 2 - title.image.GetWidth() / 2);
title.sprite.SetY(screen_h / 2 + 12);
title.sprite.SetZ(10);

sub1.image = Image.Text("Seu equipamento ganhando nova vida...", 0.886, 0.910, 0.941, 1.0, "Noto Sans 11");
sub1.sprite = Sprite(sub1.image);
sub1.sprite.SetX(screen_w / 2 - sub1.image.GetWidth() / 2);
sub1.sprite.SetY(screen_h / 2 + 52);
sub1.sprite.SetZ(10);

sub2.image = Image.Text("Otimizando desempenho, memória e interface para você", 0.580, 0.639, 0.722, 1.0, "Noto Sans 9");
sub2.sprite = Sprite(sub2.image);
sub2.sprite.SetX(screen_w / 2 - sub2.image.GetWidth() / 2);
sub2.sprite.SetY(screen_h / 2 + 76);
sub2.sprite.SetZ(10);

pbox.image = Image("progress_box.png");
pbox.sprite = Sprite(pbox.image);
pbox.x = screen_w / 2 - pbox.image.GetWidth() / 2;
pbox.y = screen_h / 2 + 114;
pbox.sprite.SetX(pbox.x);
pbox.sprite.SetY(pbox.y);
pbox.sprite.SetZ(10);

pbar.original = Image("progress_bar.png");
pbar.sprite = Sprite();
pbar.sprite.SetX(pbox.x);
pbar.sprite.SetY(pbox.y);
pbar.sprite.SetZ(11);

current_progress = 0.08;
fun update_bar(val) {
    if (val < 0.08) {
        val = 0.08;
    }
    if (val > 1.0) {
        val = 1.0;
    }
    w = Math.Int(pbar.original.GetWidth() * val);
    if (w < 8) {
        w = 8;
    }
    pbar.scaled = pbar.original.Scale(w, pbar.original.GetHeight());
    pbar.sprite.SetImage(pbar.scaled);
}
update_bar(current_progress);

fun progress_callback(duration, progress) {
    if (progress > current_progress) {
        current_progress = progress;
    }
    update_bar(current_progress);
}
Plymouth.SetBootProgressFunction(progress_callback);

fun refresh_callback() {
    if (current_progress < 0.96) {
        current_progress = current_progress + 0.006;
        update_bar(current_progress);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
    update_bar(1.0);
}
Plymouth.SetQuitFunction(quit_callback);
EOF

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R eonluxos || plymouth-set-default-theme eonluxos || true
fi

mkdir -p /etc/initramfs-tools/conf.d
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/splash

# 6. Garante getty@tty1 silencioso e mascara plymouth-quit para reter o splash ate o XFCE abrir
systemctl unmask getty@tty1.service 2>/dev/null || true
rm -f /etc/systemd/system/getty@tty1.service
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat <<'EOF' > /etc/systemd/system/getty@tty1.service.d/noclear.conf
[Service]
TTYVTDisallocate=no
StandardOutput=null
StandardError=null
EOF
ln -sf /dev/null /etc/systemd/system/plymouth-quit.service
ln -sf /dev/null /etc/systemd/system/plymouth-quit-wait.service

# 7. Permite que o utilizador live inicie o Xorg diretamente
mkdir -p /etc/X11
cat <<'EOF' > /etc/X11/Xwrapper.config
allowed_users=anybody
needs_root_rights=yes
EOF

# 8. Atualiza cache de icones GTK e reconstroi o initramfs
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/Papirus-Dark 2>/dev/null || true
fi

update-initramfs -u -k all 2>/dev/null || true
