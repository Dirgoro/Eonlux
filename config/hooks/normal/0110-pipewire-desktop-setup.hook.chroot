#!/bin/sh

set -e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

echo "[EonluxOS Hook] Habilitando serviços de vídeo, LightDM, NetworkManager e PipeWire..."

systemctl enable eonluxos-display-quirks.service || true
systemctl enable lightdm.service
systemctl enable NetworkManager.service
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service || true
