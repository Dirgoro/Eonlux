#!/bin/sh

set -e

echo "[EonluxOS Hook] Habilitando LightDM, NetworkManager e sockets PipeWire..."

systemctl enable lightdm.service
systemctl enable NetworkManager.service

# Habilita a pilha PipeWire globalmente para sessões de usuário
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service || true

# Garante propriedade correta em /etc/skel (sem tocar em /home/user)
chown -R root:root /etc/skel
