#!/bin/sh

set -e

echo "[EonluxOS Binary Hook] Gerando eonlux-splash.png para Isolinux/GRUB..."

BRAND_PNG="chroot/usr/share/plymouth/themes/eonluxos/stage3-brand.png"
if [ -f "$BRAND_PNG" ] && command -v python3 >/dev/null 2>&1; then
    python3 - << 'EOF'
from PIL import Image, ImageDraw
import glob, os

brand = Image.open("chroot/usr/share/plymouth/themes/eonluxos/stage3-brand.png").convert("RGBA")

canvas = Image.new("RGBA", (640, 480), (6, 12, 28, 255))
draw = ImageDraw.Draw(canvas)

target_w = 340
ratio = target_w / float(brand.width)
brand_resized = brand.resize((target_w, int(brand.height * ratio)), Image.Resampling.LANCZOS)
canvas.alpha_composite(brand_resized, ((640 - brand_resized.width) // 2, 18))

draw.rectangle([60, 188, 580, 370], outline=(85, 110, 145, 255), width=1)
draw.line([60, 214, 580, 214], fill=(85, 110, 145, 255), width=1)

final_splash = canvas.convert("RGB")

if os.path.isdir("binary/isolinux"):
    final_splash.save("binary/isolinux/eonlux-splash.png", "PNG")
    final_splash.save("binary/isolinux/splash.png", "PNG")

for path in glob.glob("binary/**/splash.png", recursive=True):
    final_splash.save(path, "PNG")
EOF
fi
