#!/bin/sh

set -e

echo "[EonluxOS Binary Hook] Personalizando menus de boot (Isolinux / GRUB)..."

find binary/isolinux binary/boot/grub -type f -name "*.cfg" 2>/dev/null | while read -r cfg; do
    sed -i 's/Debian GNU\/Linux 13 (trixie)/EonluxOS 1.0 Core/g' "$cfg" || true
    sed -i 's/Debian GNU\/Linux/EonluxOS 1.0 Core/g' "$cfg" || true
    sed -i 's/menu title .*/menu title EonluxOS 1.0 Core/g' "$cfg" || true
done

LOGO_SRC="chroot/usr/share/plymouth/themes/eonluxos/eonlux-logo.png"
if [ -f "$LOGO_SRC" ] && command -v python3 >/dev/null 2>&1; then
    python3 - << 'EOF'
from PIL import Image
import glob, os

src = "chroot/usr/share/plymouth/themes/eonluxos/eonlux-logo.png"
logo = Image.open(src).convert("RGBA")

canvas = Image.new("RGBA", (640, 480), (6, 12, 28, 255))
target_w = 460
ratio = target_w / float(logo.width)
logo_resized = logo.resize((target_w, int(logo.height * ratio)), Image.Resampling.LANCZOS)
pos_x = (640 - logo_resized.width) // 2
pos_y = 28
canvas.alpha_composite(logo_resized, (pos_x, pos_y))
final_splash = canvas.convert("RGB")

for path in glob.glob("binary/**/splash.png", recursive=True):
    final_splash.save(path, "PNG")
EOF
fi
