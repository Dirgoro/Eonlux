#!/bin/sh

set -e

echo "[EonluxOS Binary Hook] Copiando eonlux-splash.png para Isolinux/GRUB..."

SPLASH_SRC="chroot/usr/share/plymouth/themes/eonluxos/eonlux-splash.png"

if [ -f "$SPLASH_SRC" ]; then
    if [ -d "binary/isolinux" ]; then
        cp -f "$SPLASH_SRC" binary/isolinux/eonlux-splash.png
        cp -f "$SPLASH_SRC" binary/isolinux/splash.png
    fi

    find binary -name "splash.png" -exec cp -f "$SPLASH_SRC" {} + 2>/dev/null || true
else
    echo "[Aviso] eonlux-splash.png não encontrado em $SPLASH_SRC"
fi
