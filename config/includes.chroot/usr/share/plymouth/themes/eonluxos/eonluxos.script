// EonluxOS 1.0 Core - Tema Plymouth (Emblema + Marca + Barra alinhados em 1024x600+)

Window.SetBackgroundTopColor(0.024, 0.047, 0.110);     // #060C1C
Window.SetBackgroundBottomColor(0.024, 0.047, 0.110);  // #060C1C

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_w / 2;
center_y = screen_h / 2;

// 1. Emblema orbital rasterizado a partir de eonluxos-logo.svg (96x96)
emblem_img = Image("emblem.png");
if (emblem_img) {
    emblem_sprite = Sprite(emblem_img);
    emblem_sprite.SetX(center_x - (emblem_img.GetWidth() / 2));
    emblem_sprite.SetY(center_y - 145);
    emblem_sprite.SetZ(10);
}

// 2. Titulo da marca abaixo do emblema
brand_title_img = Image.Text("EonluxOS 1.0 Core", 0.220, 0.741, 0.973, 1, "Noto Sans Bold 16");
brand_title_sprite = Sprite(brand_title_img);
brand_title_sprite.SetX(center_x - (brand_title_img.GetWidth() / 2));
brand_title_sprite.SetY(center_y - 36);
brand_title_sprite.SetZ(10);

// 3. Barra de progresso (#137FEC sobre trilho #16223B)
bar_w = 340;
bar_h = 6;
bar_x = center_x - (bar_w / 2);
bar_y = center_y + 8;

bg_bar_sprite = Sprite();
bg_bar_sprite.SetX(bar_x);
bg_bar_sprite.SetY(bar_y);
bg_bar_sprite.SetZ(15);

fg_bar_sprite = Sprite();
fg_bar_sprite.SetX(bar_x);
fg_bar_sprite.SetY(bar_y);
fg_bar_sprite.SetZ(16);

// 4. Frases informativas abaixo da barra
title_img = Image.Text("Seu equipamento ganhando nova vida...", 0.886, 0.910, 0.941, 1, "Noto Sans Bold 11");
title_sprite = Sprite(title_img);
title_sprite.SetX(center_x - (title_img.GetWidth() / 2));
title_sprite.SetY(bar_y + 22);
title_sprite.SetZ(10);

sub_img = Image.Text("Otimizando desempenho, memória e interface para você", 0.580, 0.639, 0.722, 1, "Noto Sans 9");
sub_sprite = Sprite(sub_img);
sub_sprite.SetX(center_x - (sub_img.GetWidth() / 2));
sub_sprite.SetY(bar_y + 46);
sub_sprite.SetZ(10);

progress_val = 0.08;

fun boot_progress_callback(duration, progress) {
    if (progress > progress_val) {
        progress_val = progress;
    }
    if (progress_val > 1.0) {
        progress_val = 1.0;
    }
    fill_w = Math.Int(bar_w * progress_val);
    if (fill_w < 10) {
        fill_w = 10;
    }
    bar_track = Image("progress-track.png");
    if (bar_track) {
        bg_bar_sprite.SetImage(bar_track.Scale(bar_w, bar_h));
    }
    bar_fill = Image("progress-fill.png");
    if (bar_fill) {
        fg_bar_sprite.SetImage(bar_fill.Scale(fill_w, bar_h));
    }
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
