Window.SetBackgroundTopColor(0.023, 0.047, 0.109);
Window.SetBackgroundBottomColor(0.015, 0.031, 0.078);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

emblem_img = Image("stage2-emblem.png");
emblem_sprite = Sprite(emblem_img);
emblem_sprite.SetX(screen_w / 2 - emblem_img.GetWidth() / 2);
emblem_sprite.SetY(screen_h / 2 - emblem_img.GetHeight() / 2);
emblem_sprite.SetZ(10);
emblem_sprite.SetOpacity(1);

brand_img = Image("stage3-brand.png");
brand_sprite = Sprite(brand_img);
brand_sprite.SetX(screen_w / 2 - brand_img.GetWidth() / 2);
brand_sprite.SetY(screen_h / 2 - brand_img.GetHeight() / 2 - 42);
brand_sprite.SetZ(20);
brand_sprite.SetOpacity(0);

box_img = Image("progress_box.png");
box_sprite = Sprite(box_img);
box_x = screen_w / 2 - box_img.GetWidth() / 2;
box_y = screen_h / 2 + 68;
box_sprite.SetPosition(box_x, box_y, 21);
box_sprite.SetOpacity(0);

bar_img = Image("progress_bar.png");
bar_sprite = Sprite();
bar_sprite.SetPosition(box_x, box_y, 22);
bar_sprite.SetOpacity(0);

caption_img = Image("stage3-caption.png");
caption_sprite = Sprite(caption_img);
caption_sprite.SetX(screen_w / 2 - caption_img.GetWidth() / 2);
caption_sprite.SetY(box_y + 24);
caption_sprite.SetZ(21);
caption_sprite.SetOpacity(0);

tick = 0;
sys_progress = 0.05;
visual_progress = 0.05;

fun progress_callback (duration, progress)
{
    if (progress > sys_progress) {
        sys_progress = progress;
    }
}

fun refresh_callback ()
{
    tick++;
    
    if (tick > 55 || sys_progress > 0.15) {
        emblem_sprite.SetOpacity(0);
        brand_sprite.SetOpacity(1);
        box_sprite.SetOpacity(1);
        bar_sprite.SetOpacity(1);
        caption_sprite.SetOpacity(1);
    }

    target = sys_progress;
    min_progress = tick / 180.0;
    if (target < min_progress) {
        target = min_progress;
    }
    if (target > 1.0) {
        target = 1.0;
    }

    if (visual_progress < target) {
        visual_progress = visual_progress + (target - visual_progress) * 0.15 + 0.003;
    }
    if (visual_progress > 1.0) {
        visual_progress = 1.0;
    }

    w = Math.Int(box_img.GetWidth() * visual_progress);
    if (w < 8) w = 8;
    if (w > box_img.GetWidth()) w = box_img.GetWidth();
    bar_sprite.SetImage(bar_img.Scale(w, box_img.GetHeight()));
}

Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
