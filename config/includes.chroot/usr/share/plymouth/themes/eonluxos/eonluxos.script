# Script Plymouth do EonluxOS Core
Window.SetBackground-Color(0.058, 0.078, 0.109);

logo_image = Image("eonlux-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 40);

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = Window.GetHeight() / 2 + logo_image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 1);

progress_bar.image = Image("progress_bar.png");
fun refresh_callback ()
{
    progress_bar.sprite.SetImage(progress_bar.image.Scale(progress_bar.image.GetWidth() * Plymouth.GetProgress(), progress_bar.image.GetHeight()));
}

Plymouth.SetRefreshFunction(refresh_callback);
