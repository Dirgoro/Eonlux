// EonluxOS 1.0 Core - Tema Plymouth (Fundo com ondas/constelacao + Logo + Barra)

Window.SetBackgroundTopColor(0.024, 0.047, 0.110);     // #060C1C
Window.SetBackgroundBottomColor(0.016, 0.031, 0.078);  // #040814

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_w / 2;
center_y = screen_h / 2;

// 1. Fundo atmosferico (ondas luminosas + brilho superior + constelacao poligonal)
bg_img = Image("plymouth-bg.png");
if (bg_img) {
    bg_sprite = Sprite(bg_img.Scale(screen_w, screen_h));
    bg_sprite.SetX(0);
    bg_sprite.SetY(0);
    bg_sprite.SetZ(1);
}

// 2. Logotipo oficial EonluxOS centralizado
emblem_img = Image("emblem.png");
if (emblem_img) {
    emblem_sprite = Sprite(emblem_img);
    emblem_sprite.SetX(center_x - (emblem_img.GetWidth() / 2));
    emblem_sprite.SetY(center_y - 84 - (emblem_img.GetHeight() / 2));
    emblem_sprite.SetZ(10);
}

// 3. Titulo principal em branco nitido
brand_title_img = Image.Text("EonluxOS 1.0 Core", 1.0, 1.0, 1.0, 1, "Noto Sans Bold 16");
brand_title_sprite = Sprite(brand_title_img);
brand_title_sprite.SetX(center_x - (brand_title_img.GetWidth() / 2));
brand_title_sprite.SetY(center_y - 14);
brand_title_sprite.SetZ(10);

// 4. Frases motivacionais entre o titulo e a barra de progresso
title_img = Image.Text("Seu equipamento ganhando nova vida...", 0.886, 0.910, 0.941, 1, "Noto Sans 11");
title_sprite = Sprite(title_img);
title_sprite.SetX(center_x - (title_img.GetWidth() / 2));
title_sprite.SetY(center_y + 20);
title_sprite.SetZ(10);

sub_img = Image.Text("Otimizando desempenho, memória e interface para você", 0.580, 0.639, 0.722, 1, "Noto Sans 9");
sub_sprite = Sprite(sub_img);
sub_sprite.SetX(center_x - (sub_img.GetWidth() / 2));
sub_sprite.SetY(center_y + 42);
sub_sprite.SetZ(10);

// 5. Barra de progresso (#137FEC -> #38BDF8 sobre trilho #0F1D3A)
bar_w = 340;
bar_h = 6;
bar_x = center_x - (bar_w / 2);
bar_y = center_y + 74;

bar_track = Image("progress-track.png");
bar_fill = Image("progress-fill.png");

bg_bar_sprite = Sprite();
if (bar_track) {
    bg_bar_sprite.SetImage(bar_track.Scale(bar_w, bar_h));
}
bg_bar_sprite.SetX(bar_x);
bg_bar_sprite.SetY(bar_y);
bg_bar_sprite.SetZ(15);

fg_bar_sprite = Sprite();
fg_bar_sprite.SetX(bar_x);
fg_bar_sprite.SetY(bar_y);
fg_bar_sprite.SetZ(16);

progress_val = 0.08;

fun render_bar() {
    fill_w = Math.Int(bar_w * progress_val);
    if (fill_w < 12) {
        fill_w = 12;
    }
    if (bar_fill) {
        fg_bar_sprite.SetImage(bar_fill.Scale(fill_w, bar_h));
    }
}

fun boot_progress_callback(duration, progress) {
    if (progress > progress_val) {
        progress_val = progress;
    }
    if (progress_val > 1.0) {
        progress_val = 1.0;
    }
    render_bar();
}

fun refresh_callback() {
    if (progress_val < 0.92) {
        progress_val = progress_val + 0.0012;
        render_bar();
    }
}

render_bar();
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
