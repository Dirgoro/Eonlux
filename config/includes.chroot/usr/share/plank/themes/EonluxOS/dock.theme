[PlankTheme]
# Arredondamento suave dos cantos da dock
TopRoundness=16
BottomRoundness=16

# Espessura e cor da borda externa (borda sutil em azul elétrico com transparência)
LineWidth=1
OuterStrokeColor=19;;127;;236;;120

# Gradiente de fundo da dock (azul-escuro profundo translúcido idêntico ao do sistema)
FillStartColor=6;;12;;28;;220
FillEndColor=10;;20;;42;;235

# Brilho interno sutil
InnerStrokeColor=255;;255;;255;;30

[PlankDockTheme]
# Espaçamentos internos e margens dos ícones
HorizPadding=14
TopPadding=6
BottomPadding=6
ItemPadding=8

# Indicador de aplicativo aberto (tamanho e animações)
IndicatorSize=4
IconShadowSize=2
UrgentBounceHeight=1.2
LaunchBounceHeight=0.4
FadeOpacity=1
ClickTime=200
UrgentBounceTime=500
LaunchBounceTime=500
ActiveTime=250
SlideTime=250
FadeTime=200
HideTime=200
GlowSize=25
GlowTime=8000
GlowPulseTime=1500
UrgentHueShift=120
ItemMoveTime=300
CascadeHide=true
BadgeColor=19;;127;;236;;255
