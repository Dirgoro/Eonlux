#!/bin/sh

set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --apt-recommends false \
    --apt-indices false \
    --apt-secure true \
    --binary-images iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --debian-installer false \
    --memtest none \
    --iso-application "EonluxOS 1.0" \
    --iso-publisher "EonluxOS Project" \
    --iso-volume "EONLUXOS_1_0" \
    --bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo username=user hostname=eonluxos" \
    --linux-flavours amd64 \
    --compression xz \
    --zsync false \
    "${@}"
