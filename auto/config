#!/bin/sh
set -e

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends false \
  --debian-installer live \
  --debian-installer-distribution trixie \
  --debian-installer-gui true \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --iso-application "EonluxOS 1.0 Core" \
  --iso-publisher "EonluxOS Project" \
  --iso-volume "EONLUXOS_1_0" \
  --bootappend-live "boot=live components quiet splash plymouth.enable=1 loglevel=3 vt.global_cursor_default=0" \
  "${@}"